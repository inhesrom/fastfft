+/// Top-level leaf stages. Register width is not a radix: the 64/128/256
+/// leaves have multiple columns per register row.
+pub(crate) const fn decomposition(n: usize) -> (usize, usize) {
+    match n {
+        2 | 4 | 9 => (n, 1),
+        6 => (3, 2),
+        _ => (rows(n), n / rows(n)),
+    }
+}
