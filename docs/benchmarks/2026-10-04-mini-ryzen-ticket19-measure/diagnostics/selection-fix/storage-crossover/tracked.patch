+        let baseline = build_candidate::<f32>(len, FftDirection::Forward, &slow);
+        selection_ledger::arm();
+        let result = pick::<f32>(
+            len,
+            FftDirection::Forward,
+            isa,
+            Arc::clone(&baseline),
