+            let mut workload = 0;
+            let mut route_workloads = 0;
+            for offset in 0..OFFSETS.len() {
+                for _ in 0..lengths {
+                    for _ in PLACEMENTS {
+                        let routes = routes_at_offset(offset);
+                        assert_eq!(routes, if offset == 0 { 2 } else { 1 });
+                        let mut observed = WorkloadSamples {
+                            routes,
+                            calls: [8, 16],
+                            ..Default::default()
+                        };
+                        assert_eq!(
+                            collect_route_samples(
+                                workload,
+                                &mut observed,
+                                |route, member, calls| {
+                                    assert!(route == 0 || offset == 0);
+                                    visits[route][member] += 1;
+                                    Some(Duration::from_nanos(calls as u64 * 100))
+                                }
+                            ),
+                            Some(())
+                        );
+                        assert!(observed.complete());
+                        if offset != 0 {
+                            assert_eq!(observed.valid_mask[1], 0);
