+        let before = (pointers(&a), pointers(&b));
+        assert!(a.diagnostic_swap_phase_b(&mut b).is_err());
+        assert_eq!((pointers(&a), pointers(&b)), before);
+        assert_eq!(a.vtw[0].to_bits(), 0.0f32.to_bits());
+        assert_eq!(b.vtw[0].to_bits(), (-0.0f32).to_bits());
+    }
