+            assert_eq!(route_workloads, required_route_workloads(lengths));
+            assert_eq!(route_workloads, 12 * lengths);
+            assert_eq!(visits[0], [9 * lengths * ROUNDS; 2]);
+            assert_eq!(visits[1], [3 * lengths * ROUNDS; 2]);
