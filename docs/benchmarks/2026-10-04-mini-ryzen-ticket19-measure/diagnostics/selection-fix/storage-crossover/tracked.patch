+        for entry in &ledger.entries[..ledger.count] {
+            eprintln!(
+                "measure-ledger event={} candidate={} workload={:?} len={} placement={} offsets_complex={:?} elapsed_ns={} calls={:?} caller_routes={} masks={:?} stats_ns_Bbest_Cbest_Bmedian_Cmedian={:?} score={:?}",
+                entry.event,
+                entry.candidate,
+                entry.workload,
+                entry.len,
+                entry.placement,
+                entry.offsets_complex,
+                entry.elapsed_ns,
+                entry.calls,
+                entry.caller_routes,
+                entry.masks,
+                entry.stats_ns,
+                entry.score,
+            );
+        }
+    }
+}
