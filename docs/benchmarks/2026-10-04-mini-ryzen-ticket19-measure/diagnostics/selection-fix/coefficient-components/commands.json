  "build": "RUSTFLAGS='-C llvm-args=-align-all-functions=6' cargo build -j1 --profile arena -pfastfft-arena --features measure-diagnostics",
  "shift_tests": "cargo test -p fastfft --no-default-features --features sse2,tuning --lib coefficient_shift -- --test-threads=1"
