{
  "run": [
    "taskset",
    "-c",
    "0",
    "python3",
    "docs/benchmarks/2026-10-04-mini-ryzen-ticket19-measure/reserve-core.py",
    "--journal",
    "target/ticket19/selection-fix/coefficient-components/run-affinity.json",
    "--pid",
    "2373",
    "--starttime",
    "13351",
    "--expect-comm",
    "herdr",
    "--core",
    "4",
    "--",
    "python3",
    "docs/benchmarks/2026-10-04-mini-ryzen-ticket19-measure/quiet-run.py",
    "--attribute",
    "--core",
    "4",
    "--log",
    "target/ticket19/selection-fix/coefficient-components/run-quiet.jsonl",
    "--",
    "target/ticket19/selection-fix/coefficient-components/fastfft-arena",
    "run",
    "--suite",
    "pow2,smooth",
    "--profile",
    "full",
    "--libs",
    "fastfft,fastfft/measure",
    "--filter",
