+//! Private fixed split-layout leaves. All arithmetic/lane operations live here;
+//! the Small engine owns validation, target-feature entries and batch scheduling.
+//! Only the retained AVX2 f32 N=8/32 leaves remain. The bounded f64, N=16
+//! and AVX-512 experiments are archived with the latency checkpoint.
+use super::*;
+
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct F32x4f(__m128);
+
+macro_rules! narrow_f32 {
+    ($v:ident,$wide:ident) => {
+        arith!(
+            $v,
+            f32,
+            _mm_set1_ps,
+            _mm_add_ps,
+            _mm_sub_ps,
+            _mm_mul_ps,
+            _mm_xor_ps,
+            fma(_mm_fmadd_ps, _mm_fmsub_ps, _mm_fnmadd_ps)
+        );
+        // SAFETY: four unaligned f32 lanes; arithmetic requires AVX2+FMA.
+        unsafe impl Vector for $v {
+            type S = f32;
+            const LANES: usize = 4;
+            mem!($v, f32, 4, _mm_set1_ps, _mm_loadu_ps, _mm_storeu_ps);
+            #[inline(always)]
+            unsafe fn deinterleave(a: Self, b: Self) -> (Self, Self) {
+                // SAFETY: source/destination have the same four lanes.
+                unsafe {
+                    let (r, i) = F32x4::deinterleave(F32x4(a.0), F32x4(b.0));
+                    (Self(r.0), Self(i.0))
+                }
+            }
+            #[inline(always)]
+            unsafe fn interleave(a: Self, b: Self) -> (Self, Self) {
+                // SAFETY: source/destination have the same four lanes.
+                unsafe {
+                    let (r, i) = F32x4::interleave(F32x4(a.0), F32x4(b.0));
+                    (Self(r.0), Self(i.0))
+                }
+            }
+            #[inline(always)]
+            unsafe fn zip(a: Self, b: Self, k: usize) -> (Self, Self) {
+                // SAFETY: source/destination have the same four lanes.
+                unsafe {
+                    let (r, i) = F32x4::zip(F32x4(a.0), F32x4(b.0), k);
+                    (Self(r.0), Self(i.0))
+                }
+            }
+        }
+        // SAFETY: transpose and constant loads require only the enclosing tier.
+        unsafe impl Leaf for $v {
+            type Wide = $wide;
+            #[inline(always)]
+            unsafe fn halves(w: Self::Wide) -> (Self, Self) {
+                // SAFETY: AVX2 extract; both halves retain FMA arithmetic.
+                unsafe {
+                    (
+                        Self(_mm256_castps256_ps128(w.0)),
+                        Self(_mm256_extractf128_ps::<1>(w.0)),
+                    )
+                }
+            }
+            #[inline(always)]
+            unsafe fn constants<const J: usize>() -> (Self, Self) {
+                // Compile-time constants, never a plan-owned runtime table.
+                let [r, i] = const { roots32(J) };
+                // SAFETY: four local scalar constants in each load.
+                unsafe {
+                    (
+                        Self(_mm_setr_ps(
+                            r[0] as f32,
+                            r[1] as f32,
+                            r[2] as f32,
+                            r[3] as f32,
+                        )),
+                        Self(_mm_setr_ps(
+                            i[0] as f32,
+                            i[1] as f32,
+                            i[2] as f32,
+                            i[3] as f32,
+                        )),
+                    )
+                }
+            }
+            #[inline(always)]
+            unsafe fn transpose2(a: Self, b: Self) -> [Self; 4] {
+                // SAFETY: only the low two lanes of each result are used.
+                unsafe {
+                    let lo = _mm_unpacklo_ps(a.0, b.0);
+                    let hi = _mm_unpackhi_ps(a.0, b.0);
+                    [
+                        Self(lo),
+                        Self(_mm_movehl_ps(lo, lo)),
+                        Self(hi),
+                        Self(_mm_movehl_ps(hi, hi)),
+                    ]
+                }
+            }
+            #[inline(always)]
+            unsafe fn store2(p: *mut f32, r: Self, i: Self) {
+                // SAFETY: exactly two complex outputs, no padded stores.
+                unsafe {
+                    _mm_storeu_ps(p, _mm_unpacklo_ps(r.0, i.0));
+                }
+            }
+        }
+    };
+}
+
+/// Four-lane SIMD operations used only under the leaf's matching features.
+/// # Safety
+/// Implementations must keep four lanes in natural order and preserve FMA.
+pub(crate) unsafe trait Leaf: Vector {
+    type Wide: Vector<S = Self::S>;
+    unsafe fn halves(w: Self::Wide) -> (Self, Self);
+    unsafe fn constants<const J: usize>() -> (Self, Self);
+    unsafe fn transpose2(a: Self, b: Self) -> [Self; 4];
+    unsafe fn store2(p: *mut Self::S, r: Self, i: Self);
+}
+
+narrow_f32!(F32x4f, F32x8);
+
+const fn roots32(j: usize) -> [[f64; 4]; 2] {
+    use core::f64::consts::FRAC_1_SQRT_2 as H;
+    const ROOTS: [(f64, f64); 8] = [
+        (1., 0.),
+        (0.9807852804032304, -0.19509032201612825),
+        (0.9238795325112867, -0.3826834323650898),
+        (0.8314696123025452, -0.5555702330196022),
+        (H, -H),
+        (0.5555702330196022, -0.8314696123025452),
+        (0.3826834323650898, -0.9238795325112867),
+        (0.19509032201612825, -0.9807852804032304),
+    ];
+    let mut out = [[0.; 4]; 2];
+    let mut k = 0;
+    while k < 4 {
+        let index = j * k % 32;
+        let (r, i) = ROOTS[index % 8];
+        let (r, i) = match index / 8 {
+            0 => (r, i),
+            1 => (i, -r),
+            2 => (-r, -i),
+            _ => (-i, r),
+        };
+        out[0][k] = r;
+        out[1][k] = i;
+        k += 1;
+    }
+    out
+}
+
+#[inline(always)]
+unsafe fn radix4<V: SimdReal>(r: [V; 4], i: [V; 4]) -> ([V; 4], [V; 4]) {
+    // SAFETY: caller enables V's features. Quarter turns are swaps/signs,
+    // not complex multiplies or opaque add-pipe balancing.
+    unsafe {
+        let a = V::add(r[0], r[2]);
+        let b = V::sub(r[0], r[2]);
+        let c = V::add(r[1], r[3]);
+        let d = V::sub(r[1], r[3]);
+        let e = V::add(i[0], i[2]);
+        let f = V::sub(i[0], i[2]);
+        let g = V::add(i[1], i[3]);
+        let h = V::sub(i[1], i[3]);
+        (
+            [V::add(a, c), V::add(b, h), V::sub(a, c), V::sub(b, h)],
+            [V::add(e, g), V::sub(f, d), V::sub(e, g), V::add(f, d)],
+        )
+    }
+}
+
+#[inline(always)]
+unsafe fn twiddle<V: Leaf, const J: usize>(r: V, i: V) -> (V, V) {
+    // SAFETY: matching features, all constants are compile-time values.
+    unsafe {
+        let (c, s) = V::constants::<J>();
+        (V::fmsub(r, c, V::mul(i, s)), V::fmadd(r, s, V::mul(i, c)))
+    }
+}
+
+#[inline(always)]
+unsafe fn radix8<V: SimdReal>(r: [V; 8], i: [V; 8]) -> ([V; 8], [V; 8]) {
+    // SAFETY: matching SIMD features; all eighth/quarter turns are fixed.
+    unsafe {
+        let (e, f) = radix4([r[0], r[2], r[4], r[6]], [i[0], i[2], i[4], i[6]]);
+        let (mut o, mut p) = radix4([r[1], r[3], r[5], r[7]], [i[1], i[3], i[5], i[7]]);
+        let h = V::splat_f64(core::f64::consts::FRAC_1_SQRT_2);
+        (o[1], p[1]) = (V::mul(V::add(o[1], p[1]), h), V::mul(V::sub(p[1], o[1]), h));
+        (o[2], p[2]) = (p[2], V::neg(o[2]));
+        (o[3], p[3]) = (
+            V::mul(V::sub(p[3], o[3]), h),
+            V::mul(V::neg(V::add(o[3], p[3])), h),
+        );
+        let mut r = [e[0]; 8];
+        let mut i = r;
+        for k in 0..4 {
+            r[k] = V::add(e[k], o[k]);
+            r[k + 4] = V::sub(e[k], o[k]);
+            i[k] = V::add(f[k], p[k]);
+            i[k + 4] = V::sub(f[k], p[k]);
+        }
+        (r, i)
+    }
+}
+
+#[inline(always)]
+unsafe fn rectangular<V: Leaf>(a: [V::Wide; 4]) -> [V; 8] {
+    // SAFETY: wide tier available and four independent rows. No padded lanes.
+    unsafe {
+        // One bounded packing refinement: transpose before extracting halves.
+        // Wide zips handle both four-lane halves in parallel, reducing the
+        // shuffle count seen in the initial N32 assembly.
+        let (a0, a1) = V::Wide::zip(a[0], a[1], 1);
+        let (a2, a3) = V::Wide::zip(a[2], a[3], 1);
+        let (b0, b2) = V::Wide::zip(a0, a2, 2);
+        let (b1, b3) = V::Wide::zip(a1, a3, 2);
+        let (r0, r4) = V::halves(b0);
+        let (r1, r5) = V::halves(b1);
+        let (r2, r6) = V::halves(b2);
+        let (r3, r7) = V::halves(b3);
+        [r0, r1, r2, r3, r4, r5, r6, r7]
+    }
+}
+
+/// N=8, 2x4 DIT. Twiddle the odd-frequency row before the rectangular
+/// transpose: one four-lane constant complex multiply instead of three rows
+/// with only two useful lanes. Outputs use exact two-complex stores.
+#[inline(always)]
+pub(crate) unsafe fn leaf8<V: Leaf, const INV: bool>(input: *const V::S, output: *mut V::S) {
+    // SAFETY: validated 16-scalar buffers and matching features. All loads
+    // precede stores, including when the pointers are identical.
+    unsafe {
+        let (r0, i0) = V::deinterleave(V::load(input), V::load(input.add(4)));
+        let (r1, i1) = V::deinterleave(V::load(input.add(8)), V::load(input.add(12)));
+        let (r0, i0) = if INV { (i0, r0) } else { (r0, i0) };
+        let (r1, i1) = if INV { (i1, r1) } else { (r1, i1) };
+        let (even_r, even_i) = (V::add(r0, r1), V::add(i0, i1));
+        let (odd_r, odd_i) = twiddle::<V, 4>(V::sub(r0, r1), V::sub(i0, i1));
+        let (r, i) = radix4(V::transpose2(even_r, odd_r), V::transpose2(even_i, odd_i));
+        for j in 0..4 {
+            if INV {
+                V::store2(output.add(j * 4), i[j], r[j]);
+            } else {
+                V::store2(output.add(j * 4), r[j], i[j]);
+            }
+        }
+    }
+}
+
+/// N=32, 4x8 DIT: wide radix-4, rectangular transpose, narrow radix-8.
+/// All 64 scalar inputs are loaded before any exact-width output store.
+#[inline(always)]
+pub(crate) unsafe fn leaf32<V: Leaf, const INV: bool>(input: *const V::S, output: *mut V::S) {
+    // SAFETY: validated N32 buffers, matching wide and narrow target features.
+    unsafe {
+        let mut a = [V::Wide::splat_f64(0.); 4];
+        let mut b = a;
+        for j in 0..4 {
+            let (r, i) = V::Wide::deinterleave(
+                V::Wide::load(input.add(j * 16)),
+                V::Wide::load(input.add(j * 16 + 8)),
+            );
+            (a[j], b[j]) = if INV { (i, r) } else { (r, i) };
+        }
+        (a, b) = radix4(a, b);
+        let mut r = rectangular::<V>(a);
+        let mut i = rectangular::<V>(b);
+        (r[1], i[1]) = twiddle::<V, 1>(r[1], i[1]);
+        (r[2], i[2]) = twiddle::<V, 2>(r[2], i[2]);
+        (r[3], i[3]) = twiddle::<V, 3>(r[3], i[3]);
+        (r[4], i[4]) = twiddle::<V, 4>(r[4], i[4]);
+        (r[5], i[5]) = twiddle::<V, 5>(r[5], i[5]);
+        (r[6], i[6]) = twiddle::<V, 6>(r[6], i[6]);
+        (r[7], i[7]) = twiddle::<V, 7>(r[7], i[7]);
+        (r, i) = radix8(r, i);
+        for j in 0..8 {
+            let (lo, hi) = if INV {
+                V::interleave(i[j], r[j])
+            } else {
+                V::interleave(r[j], i[j])
+            };
+            V::store(output.add(j * 8), lo);
+            V::store(output.add(j * 8 + 4), hi);
+        }
+    }
+}
diff --git a/crates/fastfft/src/small_dispatch.rs b/crates/fastfft/src/small_dispatch.rs
new file mode 100644
index 0000000..a96f9ad
--- /dev/null
+++ b/crates/fastfft/src/small_dispatch.rs
@@ -0,0 +1,142 @@
+//! Focused Zen 4 choices, separate from the general cost model (ticket 18).
+//! Incumbents: docs/benchmarks/2026-09-26-mini-ryzen-small-engine/.
+//! Bounded latency experiments: ../2026-09-26-mini-ryzen-small-latency/.
+
+use crate::engine::Shape;
+use crate::isa::Isa;
+use crate::planner::CandidateKernel;
+use CandidateKernel::{GenericSmall as G, Stockham as S};
+use Isa::{Avx2, Avx512, Avx512Ymm, Scalar, Sse2};
+
+type Choice = (CandidateKernel, Isa, usize);
+
+pub(super) fn preferred(n: usize, isa: Isa, f64_: bool) -> Option<(CandidateKernel, Shape)> {
+    // Interleaved leaves, AVX-512VL's 32 registers first where the rows need
+    // them; the AVX2 N=64 leaf spills and loses to the incumbent.
+    let tiers: &[Isa] = match (f64_, n, isa) {
+        (true, 32, Avx512Ymm | Avx512) | (false, 128, Avx512Ymm | Avx512) => &[Avx512Ymm, Avx2],
+        (false, 64, Avx512Ymm | Avx512) => &[Avx512Ymm],
+        (_, 2 | 4 | 8 | 16 | 32, Avx2 | Avx512Ymm | Avx512) | (false, 128, Avx2) => &[Avx2],
+        _ => &[],
+    };
+    let compiled = crate::engine::small::interleaved_shapes(n, isa, f64_);
+    tiers
+        .iter()
+        .map(|&isa| Shape {
+            isa,
+            lanes: crate::engine::small::interleaved_lanes(n, f64_),
+        })
+        .find(|shape| compiled.contains(shape))
+        .map(|shape| (CandidateKernel::InterleavedSmall, shape))
+        .or_else(|| incumbent(n, isa, f64_))
+}
+
+/// Preserve the current-Small baseline fallback, including inside Measure's
+/// first eight. This table is not generated by the latency analysis script.
+pub(super) fn incumbent(n: usize, isa: Isa, f64_: bool) -> Option<(CandidateKernel, Shape)> {
+    let choices: [Choice; 5] = match (f64_, n) {
+        (false, 2 | 4) | (true, 2 | 3 | 6 | 9) => [(G, Scalar, 1); 5],
+        (false, 3 | 5 | 6 | 7 | 8 | 9 | 10 | 11 | 13 | 15)
+        | (true, 4 | 5 | 7 | 8 | 11 | 12 | 13 | 15) => [
+            (G, Scalar, 1),
+            (G, Scalar, 1),
+            (G, Avx2, 1),
+            (G, Avx2, 1),
+            (G, Avx2, 1),
+        ],
+        (false, 12) => [
+            (G, Scalar, 1),
+            (G, Sse2, 4),
+            (G, Avx2, 1),
+            (G, Avx2, 1),
+            (G, Avx2, 1),
+        ],
+        (true, 10) => [
+            (G, Scalar, 1),
+            (G, Scalar, 1),
+            (G, Scalar, 1),
+            (G, Avx512Ymm, 1),
+            (G, Avx512Ymm, 1),
+        ],
+        (false, 14) | (true, 14) => [
+            (G, Scalar, 1),
+            (G, Scalar, 1),
+            (G, Avx2, 1),
+            (G, Avx512Ymm, 1),
+            (G, Avx512Ymm, 1),
+        ],
+        (false, 16) => [
+            (G, Scalar, 1),
+            (G, Sse2, 4),
+            (G, Sse2, 4),
+            (G, Sse2, 4),
+            (G, Sse2, 4),
+        ],
+        (false, 24 | 40 | 48 | 56) => [
+            (S, Scalar, 1),
+            (S, Sse2, 4),
+            (G, Avx2, 8),
+            (G, Avx512Ymm, 8),
+            (G, Avx512Ymm, 8),
+        ],
+        (false, 32 | 64) => [
+            (S, Scalar, 1),
+            (S, Sse2, 4),
+            (G, Avx2, 8),
+            (S, Avx512Ymm, 8),
+            (S, Avx512Ymm, 8),
+        ],
+        (false, 128 | 256) => [
+            (S, Scalar, 1),
+            (S, Sse2, 4),
+            (S, Avx2, 8),
+            (S, Avx512Ymm, 8),
+            (S, Avx512Ymm, 8),
+        ],
+        (true, 16) => [
+            (G, Scalar, 1),
+            (G, Scalar, 1),
+            (G, Avx2, 4),
+            (G, Avx512Ymm, 4),
+            (G, Avx512Ymm, 4),
+        ],
+        (true, 24) => [
+            (S, Scalar, 1),
+            (S, Sse2, 2),
+            (S, Sse2, 2),
+            (S, Sse2, 2),
+            (G, Avx512, 8),
+        ],
+        (true, 32 | 40 | 48 | 56) => [
+            (S, Scalar, 1),
+            (S, Sse2, 2),
+            (S, Avx2, 4),
+            (S, Avx512Ymm, 4),
+            (G, Avx512, 8),
+        ],
+        (true, 64) => [
+            (S, Scalar, 1),
+            (S, Sse2, 2),
+            (S, Avx2, 4),
+            (S, Avx512Ymm, 4),
+            (S, Avx512, 8),
+        ],
+        (true, 128 | 256) => [
+            (S, Scalar, 1),
+            (S, Sse2, 2),
+            (S, Avx2, 4),
+            (S, Avx512Ymm, 4),
+            (S, Avx512Ymm, 4),
+        ],
+        _ => return None,
+    };
+    let index = match isa {
+        Scalar => 0,
+        Sse2 => 1,
+        Avx2 => 2,
+        Avx512Ymm => 3,
+        Avx512 => 4,
+    };
+    let (kernel, isa, lanes) = choices[index];
+    Some((kernel, Shape { isa, lanes }))
+}
diff --git a/crates/fastfft/src/specialized_tests.rs b/crates/fastfft/src/specialized_tests.rs
new file mode 100644
index 0000000..c0b0df8
--- /dev/null
+++ b/crates/fastfft/src/specialized_tests.rs
@@ -0,0 +1,273 @@
+//! Exercise every retained specialized and interleaved candidate, not just
+//! Estimate defaults.
+use crate::api::{FftDirection, FftNum};
+use crate::engine::{Shape, small};
+use crate::isa::{Precision, detected_isa};
+use fastfft_testkit::{Dir, error_vs_dd, random_c64, reference_dd};
+use num_complex::Complex;
+
+#[repr(C, align(64))]
+struct Shifted<T> {
+    prefix: T,
+    data: [Complex<T>; 400],
+    suffix: T,
+}
+
+fn run<T: FftNum>() {
+    let zero = Complex::new(T::zero(), T::zero());
+    let guard = Complex::new(T::from_f64(4321.).unwrap(), T::from_f64(-8765.).unwrap());
+    type Build<T> = fn(usize, FftDirection, Shape) -> std::sync::Arc<dyn crate::Fft<T>>;
+    for n in [2, 4, 8, 16, 32, 64, 128] {
+        let f64_ = T::precision() == Precision::F64;
+        let special = small::specialized_shapes(n, detected_isa(), f64_)
+            .into_iter()
+            .map(|s| (s, small::build_specialized::<T> as Build<T>));
+        let interleaved = small::interleaved_shapes(n, detected_isa(), f64_)
+            .into_iter()
+            .map(|s| (s, small::build_interleaved::<T> as Build<T>));
+        for (shape, build) in special.chain(interleaved) {
+            for dir in [FftDirection::Forward, FftDirection::Inverse] {
+                let f = build(n, dir, shape);
+                let inv = build(n, dir.opposite_direction(), shape);
+                for count in [1, 3] {
+                    let input: Vec<_> = random_c64(n * count, 19)
+                        .iter()
+                        .map(|z| {
+                            Complex::new(T::from_f64(z.re).unwrap(), T::from_f64(z.im).unwrap())
+                        })
+                        .collect();
+                    let widen = |b: &[Complex<T>]| {
+                        b.iter()
+                            .map(|z| Complex::new(z.re.to_f64().unwrap(), z.im.to_f64().unwrap()))
+                            .collect::<Vec<_>>()
+                    };
+                    let refs: Vec<_> = input
+                        .chunks(n)
+                        .map(|chunk| {
+                            reference_dd(
+                                &widen(chunk),
+                                if dir == FftDirection::Forward {
+                                    Dir::Forward
+                                } else {
+                                    Dir::Inverse
+                                },
+                            )
+                        })
+                        .collect();
+                    for offset in 0..8 {
+                        for mode in 0..4 {
+                            let mut a = Shifted {
+                                prefix: guard.re,
+                                data: [guard; 400],
+                                suffix: guard.im,
+                            };
+                            let mut b = Shifted {
+                                prefix: guard.re,
+                                data: [guard; 400],
+                                suffix: guard.im,
+                            };
+                            assert_eq!(
+                                a.data.as_ptr() as usize % size_of::<Complex<T>>(),
+                                size_of::<T>()
+                            );
+                            a.data[offset..offset + n * count].copy_from_slice(&input);
+                            let saved = a.data;
+                            let src = &mut a.data[offset..offset + n * count];
+                            let dst = &mut b.data[offset..offset + n * count];
+                            let mut scratch = [guard; 3];
+                            match mode {
+                                0 => f.process_with_scratch(src, &mut scratch),
+                                1 => f.process_outofplace_with_scratch(src, dst, &mut scratch),
+                                2 => f.process_immutable_with_scratch(src, dst, &mut scratch),
+                                _ => f.process(src),
+                            }
+                            assert_eq!(scratch, [guard; 3]);
+                            if mode == 1 || mode == 2 {
+                                assert_eq!(a.data, saved);
+                            }
+                            for v in [&a, &b] {
+                                assert_eq!(v.prefix, guard.re);
+                                assert_eq!(v.suffix, guard.im);
+                                assert!(
+                                    v.data[..offset]
+                                        .iter()
+                                        .chain(&v.data[offset + n * count..])
+                                        .all(|&z| z == guard)
+                                );
+                            }
+                            let out = if mode == 0 || mode == 3 {
+                                &mut a.data
+                            } else {
+                                &mut b.data
+                            };
+                            for (chunk, r) in out[offset..offset + n * count].chunks(n).zip(&refs) {
+                                let e = error_vs_dd(&widen(chunk), r).rel_l2
+                                    / T::epsilon().to_f64().unwrap();
+                                assert!(
+                                    e.is_finite() && e <= 2. * (n as f64).log2() + 2.,
+                                    "{shape:?} n={n} {dir} mode={mode}: {e}"
+                                );
+                            }
+                            inv.process(&mut out[offset..offset + n * count]);
+                            for (z, x) in out[offset..offset + n * count].iter().zip(&input) {
+                                let scale = T::from_usize(n).unwrap();
+                                let err = ((z.re / scale - x.re).abs()
+                                    + (z.im / scale - x.im).abs())
+                                .to_f64()
+                                .unwrap();
+                                assert!(
+                                    err.is_finite() && err < 64. * T::epsilon().to_f64().unwrap()
+                                );
+                            }
+                        }
+                    }
+                }
+                for len in [0, n - 1, n + 1] {
+                    for mode in 0..4 {
+                        let mut src = vec![zero; len];
+                        let mut dst = src.clone();
+                        let result =
+                            std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| match mode {
+                                0 => f.process_with_scratch(&mut src, &mut []),
+                                1 => f.process_outofplace_with_scratch(&mut src, &mut dst, &mut []),
+                                2 => f.process_immutable_with_scratch(&src, &mut dst, &mut []),
+                                _ => f.process(&mut src),
+                            }));
+                        assert!(
+                            result.is_err(),
+                            "bad buffer accepted: {shape:?} {n} len={len} mode={mode}"
+                        );
+                    }
+                }
+                for len in [0, n - 1, n + 1, 2 * n] {
+                    let mut src = vec![zero; n];
+                    let mut dst = vec![zero; len];
+                    assert!(
+                        std::panic::catch_unwind(std::panic::AssertUnwindSafe(
+                            || f.process_outofplace_with_scratch(&mut src, &mut dst, &mut [])
+                        ))
+                        .is_err()
+                    );
+                    assert!(
+                        std::panic::catch_unwind(std::panic::AssertUnwindSafe(
+                            || f.process_immutable_with_scratch(&src, &mut dst, &mut [])
+                        ))
+                        .is_err()
+                    );
+                }
+            }
+        }
+    }
+}
+
+fn planner_contracts<T: FftNum>() {
+    use crate::isa::Isa;
+    use crate::{FftPlanner, PlanMode, PlannerOptions};
+    use std::sync::Arc;
+    use std::time::Duration;
+    for cap in [
+        Isa::Scalar,
+        Isa::Sse2,
+        Isa::Avx2,
+        Isa::Avx512Ymm,
+        Isa::Avx512,
+    ] {
+        for mode in [
+            PlanMode::Estimate,
+            PlanMode::Measure {
+                time_limit: Duration::ZERO,
+            },
+        ] {
+            let mut p = FftPlanner::<T>::with_options(
+                PlannerOptions::default().with_isa_cap(cap).with_mode(mode),
+            );
+            for n in [2, 4, 8, 16, 32, 64, 128] {
+                for dir in [FftDirection::Forward, FftDirection::Inverse] {
+                    let f = p.plan_fft(n, dir);
+                    assert!(Arc::ptr_eq(&f, &p.plan_fft(n, dir)));
+                    let desc = p.describe_plan(n, dir);
+                    assert!(p.isa() <= cap);
+                    if desc.starts_with("small") {
+                        assert!(
+                            desc.contains("kernel=generic")
+                                || desc.contains("kernel=specialized")
+                                || desc.contains("kernel=interleaved")
+                        );
+                        assert!(desc.contains("decomposition=") && desc.contains("scratch=0"));
+                        assert_eq!(
+                            (
+                                f.get_inplace_scratch_len(),
+                                f.get_outofplace_scratch_len(),
+                                f.get_immutable_scratch_len()
+                            ),
+                            (0, 0, 0)
+                        );
+                    }
+                    if desc.contains("kernel=interleaved") {
+                        assert!(
+                            matches!(n, 2 | 4 | 8 | 16 | 32 | 64 | 128)
+                                && crate::isa::available(Isa::Avx2)
+                        );
+                        assert!(
+                            (desc.starts_with("small avx2 ") && cap >= Isa::Avx2)
+                                || (desc.starts_with("small avx512-ymm ") && cap >= Isa::Avx512Ymm)
+                        );
+                    }
+                    if desc.contains("kernel=specialized") {
+                        assert_eq!(T::precision(), Precision::F32);
+                        assert!(matches!(n, 8 | 32) && crate::isa::available(Isa::Avx2));
+                        assert!(desc.starts_with("small avx2 "));
+                    }
+                }
+            }
+        }
+    }
+}
+
+#[test]
+fn preserved_incumbent_dispatch() {
+    use crate::isa::Isa;
+    // FNV-1a over all 230 choices in the preserved current-Small baseline.
+    // Guards the discriminant/table rewrite against unrelated-size tuning.
+    let mut fingerprint = 0xcbf29ce484222325u64;
+    for f64_ in [false, true] {
+        for n in 2..=256 {
+            for cap in [
+                Isa::Scalar,
+                Isa::Sse2,
+                Isa::Avx2,
+                Isa::Avx512Ymm,
+                Isa::Avx512,
+            ] {
+                if let Some((kernel, shape)) = crate::small_dispatch::incumbent(n, cap, f64_) {
+                    for byte in format!(
+                        "{f64_}:{n}:{cap}:{}:{}:{};",
+                        kernel.name(),
+                        shape.isa,
+                        shape.lanes
+                    )
+                    .bytes()
+                    {
+                        fingerprint = (fingerprint ^ u64::from(byte)).wrapping_mul(0x100000001b3);
+                    }
+                }
+            }
+        }
+    }
+    assert_eq!(fingerprint, 0x0869c8587ef6b4d2);
+}
+
+#[test]
+fn latency_planner_contracts() {
+    planner_contracts::<f32>();
+    planner_contracts::<f64>();
+}
+
+#[test]
+fn all_specialized_contracts_f32() {
+    run::<f32>();
+}
+#[test]
+fn all_specialized_contracts_f64() {
+    run::<f64>();
+}
