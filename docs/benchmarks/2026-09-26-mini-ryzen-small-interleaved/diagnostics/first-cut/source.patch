+//! Planning, validation and target-feature entries for the interleaved leaves.
+use super::*;
+use crate::isa::x86::interleaved::{R32, R64, Row, leaf, table, table_len};
+
+struct Interleaved<T, R, E, const N: usize, const INV: bool> {
+    tw: Vec<T>,
+    row: PhantomData<fn() -> (R, E)>,
+}
+
+/// Target-feature boundary. The leaves are identical; AVX-512VL gives them
+/// 32 vector registers, which the register-resident N=64/128 stages need.
+trait Entry: 'static {
+    /// One transform. Pointers hold N complex values and are identical or
+    /// disjoint; the table holds `table_len(N)` scalars; features match.
+    unsafe fn one<R: Row, const N: usize, const INV: bool>(
+        input: *const R::S,
+        output: *mut R::S,
+        tw: *const R::S,
+    );
+    /// As `one`, for `count` consecutive transforms.
+    unsafe fn run<R: Row, const N: usize, const INV: bool>(
+        input: *const R::S,
+        output: *mut R::S,
+        count: usize,
+        tw: *const R::S,
+    );
+}
+
+macro_rules! entry {
+    ($name:ident, $features:literal) => {
+        struct $name;
+        impl Entry for $name {
+            #[target_feature(enable = $features)]
+            unsafe fn one<R: Row, const N: usize, const INV: bool>(
+                input: *const R::S,
+                output: *mut R::S,
+                tw: *const R::S,
+            ) {
+                // SAFETY: forwarded buffer, table and feature contract.
+                unsafe { leaf::<R, N, INV>(input, output, tw) }
+            }
+            #[target_feature(enable = $features)]
+            unsafe fn run<R: Row, const N: usize, const INV: bool>(
+                mut input: *const R::S,
+                mut output: *mut R::S,
+                count: usize,
+                tw: *const R::S,
+            ) {
+                // SAFETY: each iteration consumes exactly N complex values, as
+                // validated by the public wrapper; leaves load before storing.
+                unsafe {
+                    for _ in 0..count {
+                        leaf::<R, N, INV>(input, output, tw);
+                        input = input.add(2 * N);
+                        output = output.add(2 * N);
+                    }
+                }
+            }
+        }
+    };
+}
+entry!(Avx2, "avx2,fma");
+#[cfg(feature = "avx512")]
+entry!(
+    Avx512,
+    "avx512f,avx512vl,avx512dq,avx512bw,avx512cd,avx2,fma"
+);
+
+impl<T, R, E, const N: usize, const INV: bool> Length for Interleaved<T, R, E, N, INV> {
+    fn len(&self) -> usize {
+        N
+    }
+}
+impl<T, R, E, const N: usize, const INV: bool> Direction for Interleaved<T, R, E, N, INV> {
+    fn fft_direction(&self) -> FftDirection {
+        if INV {
+            FftDirection::Inverse
+        } else {
+            FftDirection::Forward
+        }
+    }
+}
+impl<T: FftNum, R: Row + 'static, E: Entry, const N: usize, const INV: bool> Fft<T>
+    for Interleaved<T, R, E, N, INV>
+{
+    fn process(&self, buffer: &mut [Complex<T>]) {
+        self.process_with_scratch(buffer, &mut []);
+    }
+    fn process_with_scratch(&self, buffer: &mut [Complex<T>], _: &mut [Complex<T>]) {
+        let tw = self.tw.as_ptr().cast();
+        if buffer.len() == N {
+            let (input, output) = (buffer.as_ptr().cast(), buffer.as_mut_ptr().cast());
+            // SAFETY: one complete aliased transform; T=R::S and the entry's
+            // features checked in the builder; leaves load before storing.
+            // N <= 4 needs only baseline SSE2, so it inlines here.
+            unsafe {
+                if N <= 4 {
+                    leaf::<R, N, INV>(input, output, tw);
+                } else {
+                    E::one::<R, N, INV>(input, output, tw);
+                }
+            }
+            return;
+        }
+        if buffer.len() < N || !buffer.len().is_multiple_of(N) {
+            fail_inplace(N, buffer.len(), 0, 0);
+        }
+        // SAFETY: complete chunks, matching scalar type and features.
+        unsafe {
+            E::run::<R, N, INV>(
+                buffer.as_ptr().cast(),
+                buffer.as_mut_ptr().cast(),
+                buffer.len() / N,
+                tw,
+            );
+        }
+    }
+    fn process_outofplace_with_scratch(
+        &self,
+        input: &mut [Complex<T>],
+        output: &mut [Complex<T>],
+        scratch: &mut [Complex<T>],
+    ) {
+        self.process_immutable_with_scratch(input, output, scratch);
+    }
+    fn process_immutable_with_scratch(
+        &self,
+        input: &[Complex<T>],
+        output: &mut [Complex<T>],
+        _: &mut [Complex<T>],
+    ) {
+        let tw = self.tw.as_ptr().cast();
+        if input.len() == N && output.len() == N {
+            let (input, output) = (input.as_ptr().cast(), output.as_mut_ptr().cast());
+            // SAFETY: one complete disjoint transform; leaves only read input.
+            // N <= 4 needs only baseline SSE2, so it inlines here.
+            unsafe {
+                if N <= 4 {
+                    leaf::<R, N, INV>(input, output, tw);
+                } else {
+                    E::one::<R, N, INV>(input, output, tw);
+                }
+            }
+            return;
+        }
+        if input.len() != output.len() || input.len() < N || !input.len().is_multiple_of(N) {
+            fail_outofplace(N, input.len(), output.len(), 0, 0);
+        }
+        // SAFETY: equal lengths of complete chunks in disjoint buffers.
+        unsafe {
+            E::run::<R, N, INV>(
+                input.as_ptr().cast(),
+                output.as_mut_ptr().cast(),
+                input.len() / N,
+                tw,
+            );
+        }
+    }
+    fn get_inplace_scratch_len(&self) -> usize {
+        0
+    }
+    fn get_outofplace_scratch_len(&self) -> usize {
+        0
+    }
+    fn get_immutable_scratch_len(&self) -> usize {
+        0
+    }
+}
+
+/// N=64 and N=128 are f32-only: f64 rows need twice the registers.
+pub(super) fn shapes(n: usize, cap: Isa, f64_: bool) -> Vec<Shape> {
+    let sizes: &[usize] = if f64_ {
+        &[2, 4, 8, 16, 32]
+    } else {
+        &[2, 4, 8, 16, 32, 64, 128]
+    };
+    if !sizes.contains(&n) {
+        return Vec::new();
+    }
+    [Isa::Avx2, Isa::Avx512Ymm]
+        .into_iter()
+        .filter(|&isa| isa <= cap && crate::isa::available(isa))
+        .map(|isa| Shape {
+            isa,
+            lanes: interleaved_lanes(n, f64_),
+        })
+        .collect()
+}
+
+fn sized<T: FftNum, R: Row + 'static, E: Entry, const N: usize>(
+    dir: FftDirection,
+) -> Arc<dyn Fft<T>> {
+    assert_eq!(size_of::<T>(), size_of::<R::S>());
+    let tw = table(N, |k, n| {
+        let (r, i) = crate::twiddle::omega(k, n);
+        let i = if dir == FftDirection::Inverse { -i } else { i };
+        (T::from_f64(r).unwrap(), T::from_f64(i).unwrap())
+    });
+    assert_eq!(tw.len(), table_len(N));
+    if dir == FftDirection::Inverse {
+        Arc::new(Interleaved::<T, R, E, N, true> {
+            tw,
+            row: PhantomData,
+        })
+    } else {
+        Arc::new(Interleaved::<T, R, E, N, false> {
+            tw,
+            row: PhantomData,
+        })
+    }
+}
+
+pub(super) fn build<T: FftNum>(n: usize, dir: FftDirection, shape: Shape) -> Arc<dyn Fft<T>> {
+    let f64_ = T::precision() == Precision::F64;
+    assert!(shapes(n, shape.isa, f64_).contains(&shape));
+    macro_rules! go {
+        ($e:ty) => {
+            match (f64_, n) {
+                (false, 2) => sized::<T, R32, $e, 2>(dir),
+                (false, 4) => sized::<T, R32, $e, 4>(dir),
+                (false, 8) => sized::<T, R32, $e, 8>(dir),
+                (false, 16) => sized::<T, R32, $e, 16>(dir),
+                (false, 32) => sized::<T, R32, $e, 32>(dir),
+                (false, 64) => sized::<T, R32, $e, 64>(dir),
+                (false, 128) => sized::<T, R32, $e, 128>(dir),
+                (true, 2) => sized::<T, R64, $e, 2>(dir),
+                (true, 4) => sized::<T, R64, $e, 4>(dir),
+                (true, 8) => sized::<T, R64, $e, 8>(dir),
+                (true, 16) => sized::<T, R64, $e, 16>(dir),
+                (true, 32) => sized::<T, R64, $e, 32>(dir),
+                _ => unreachable!("unsupported interleaved Small size"),
+            }
+        };
+    }
+    match shape.isa {
+        Isa::Avx2 => go!(Avx2),
+        #[cfg(feature = "avx512")]
+        Isa::Avx512Ymm => go!(Avx512),
+        _ => unreachable!("unsupported interleaved tier"),
+    }
+}
diff --git a/crates/fastfft/src/engine/small/specialized.rs b/crates/fastfft/src/engine/small/specialized.rs
new file mode 100644
index 0000000..87fa124
--- /dev/null
+++ b/crates/fastfft/src/engine/small/specialized.rs
@@ -0,0 +1,66 @@
+//! Planning and target-feature scheduling for retained split-layout leaves.
+use super::*;
+use crate::isa::x86::small::{F32x4f, leaf8, leaf32};
+
+// Never exposed as a general Stockham shape.
+impl SmallVector for F32x4f {}
+struct Avx2Leaf;
+
+impl Kernel<F32x4f> for Avx2Leaf {
+    const TABLES: bool = false;
+    #[target_feature(enable = "avx2,fma")]
+    unsafe fn one<const N: usize, const M: usize, const L: usize, const INV: bool>(
+        input: *const f32,
+        output: *mut f32,
+        _tw: *const f32,
+    ) {
+        const {
+            assert!(N == 8 || N == 32);
+        }
+        // SAFETY: builder verifies size/tier; wrapper validates complete buffers.
+        unsafe {
+            if N == 8 {
+                leaf8::<F32x4f, INV>(input, output);
+            } else {
+                leaf32::<F32x4f, INV>(input, output);
+            }
+        }
+    }
+    #[target_feature(enable = "avx2,fma")]
+    unsafe fn run<const N: usize, const M: usize, const L: usize, const INV: bool>(
+        mut input: *const f32,
+        mut output: *mut f32,
+        count: usize,
+        _tw: *const f32,
+    ) {
+        const {
+            assert!(N == 8 || N == 32);
+        }
+        // SAFETY: count complete chunks, aliasing only in-place, matching ISA.
+        unsafe {
+            for _ in 0..count {
+                if N == 8 {
+                    leaf8::<F32x4f, INV>(input, output);
+                } else {
+                    leaf32::<F32x4f, INV>(input, output);
+                }
+                input = input.add(2 * N);
+                output = output.add(2 * N);
+            }
+        }
+    }
+}
+
+pub(super) fn build_with<T: FftNum, F: Factory<T>>(
+    n: usize,
+    dir: FftDirection,
+    shape: Shape,
+) -> F::Output {
+    assert!(specialized_shapes(n, shape.isa, T::precision() == Precision::F64).contains(&shape));
+    assert_eq!(T::precision(), Precision::F32);
+    match n {
+        8 => sized::<T, F32x4f, F, 8, 2, 4, Avx2Leaf>(dir),
+        32 => sized::<T, F32x4f, F, 32, 4, 8, Avx2Leaf>(dir),
+        _ => unreachable!("unsupported specialized Small size"),
+    }
+}
diff --git a/crates/fastfft/src/engine/small/timing.rs b/crates/fastfft/src/engine/small/timing.rs
new file mode 100644
index 0000000..bf7b537
--- /dev/null
+++ b/crates/fastfft/src/engine/small/timing.rs
@@ -0,0 +1,73 @@
+//! Private, test-only access to the concrete wrapper and real kernel entry.
+use super::*;
+use crate::diagnostic::{Sample, enabled, sample, wrapper};
+use std::hint::black_box;
+
+struct TimingFactory;
+impl<T: FftNum> Factory<T> for TimingFactory {
+    type Output = Vec<Sample>;
+    fn make<
+        V: SmallVector,
+        const N: usize,
+        const M: usize,
+        const L: usize,
+        const INV: bool,
+        K: Kernel<V>,
+    >(
+        plan: Small<T, V, N, M, L, INV, K>,
+    ) -> Self::Output {
+        crate::diagnostic::addresses::<Small<T, V, N, M, L, INV, K>>(
+            <Small<T, V, N, M, L, INV, K> as Fft<T>>::process_immutable_with_scratch as *const ()
+                as usize,
+            K::one::<N, M, L, INV> as *const () as usize,
+        );
+        let mut result = wrapper(&plan, "concrete");
+        if !enabled("SURFACE", "kernel") {
+            return result;
+        }
+        let zero = Complex::new(T::zero(), T::zero());
+        let mut input = vec![zero; N];
+        let mut output = input.clone();
+        // The constructor already checked T=V::S, N=M*L, and CPU features.
+        // Complete input/output slices and twiddles stay alive across timing.
+        assert_eq!(input.len(), N);
+        assert_eq!(output.len(), N);
+        let ip = input.as_mut_ptr().cast::<V::S>();
+        let op = output.as_mut_ptr().cast::<V::S>();
+        let tw = plan.tw.as_ptr().cast::<V::S>();
+        for placement in ["ip", "op", "immutable"] {
+            let dst = if placement == "ip" { ip } else { op };
+            let ns = sample(|| {
+                // SAFETY: validated live pointers, same feature entry as production;
+                // aliasing only for IP, every input loaded before any store.
+                unsafe {
+                    K::one::<N, M, L, INV>(black_box(ip), black_box(dst), black_box(tw));
+                }
+                black_box(dst);
+            });
+            // Observation after the loop as well as the per-call memory barrier.
+            black_box(&input);
+            black_box(&output);
+            result.push(Sample {
+                surface: "kernel",
+                placement,
+                ns,
+            });
+        }
+        result
+    }
+}
+pub(crate) fn timings<T: FftNum>(
+    n: usize,
+    dir: FftDirection,
+    shape: Shape,
+    special: bool,
+) -> Vec<Sample> {
+    if special {
+        #[cfg(all(target_arch = "x86_64", feature = "avx2"))]
+        return specialized::build_with::<T, TimingFactory>(n, dir, shape);
+        #[cfg(not(all(target_arch = "x86_64", feature = "avx2")))]
+        unreachable!("no specialized leaves compiled");
+    }
+    build_with::<T, TimingFactory>(n, dir, shape)
+}
diff --git a/crates/fastfft/src/engine/timing.rs b/crates/fastfft/src/engine/timing.rs
new file mode 100644
index 0000000..9ceb412
--- /dev/null
+++ b/crates/fastfft/src/engine/timing.rs
@@ -0,0 +1,100 @@
+//! Test-only generic Stockham timing; preparation never enters the sample loop.
+use super::{
+    Shape,
+    stockham::{Mode, StockhamPlan},
+};
+use crate::api::{Fft, FftDirection, FftNum};
+use crate::diagnostic::{Sample, enabled, sample, wrapper};
+use crate::fft::{FftImpl, Kernel, align_slack};
+use crate::isa::Precision;
+use num_complex::Complex;
+use std::hint::black_box;
+
+pub(crate) fn stockham<T: FftNum>(
+    n: usize,
+    dir: FftDirection,
+    shape: Shape,
+    radices: &[usize],
+) -> Vec<Sample> {
+    assert!(crate::isa::available(shape.isa));
+    let f = FftImpl::new(
+        n,
+        dir,
+        Kernel::Stockham {
+            shape,
+            plan: StockhamPlan::new(n, shape.lanes, radices.to_vec()),
+        },
+        String::new(),
+    );
+    let mut result = wrapper(&f, "concrete");
+    if !enabled("SURFACE", "kernel") {
+        return result;
+    }
+    let zero = Complex::new(T::zero(), T::zero());
+    let mut input = vec![zero; n];
+    let mut output = input.clone();
+    let need = f
+        .get_inplace_scratch_len()
+        .max(f.get_outofplace_scratch_len())
+        .max(f.get_immutable_scratch_len());
+    let mut scratch = vec![zero; need];
+    let Kernel::Stockham { plan, .. } = f.into_kernel() else {
+        unreachable!()
+    };
+    let ip = input.as_mut_ptr().cast::<T>();
+    let op = output.as_mut_ptr().cast::<T>();
+    let sp = scratch.as_mut_ptr();
+    let offset = if need == 0 {
+        0
+    } else {
+        sp.align_offset(64).min(align_slack::<T>())
+    };
+    assert_eq!(input.len(), n);
+    assert_eq!(output.len(), n);
+    // SAFETY: bounded by reserved alignment slack, all buffers stay alive.
+    let sp = unsafe { sp.add(offset).cast::<T>() };
+    let inverse = dir == FftDirection::Inverse;
+    for (placement, mode) in [
+        ("ip", Mode::InPlace),
+        ("op", Mode::OutOfPlace),
+        ("immutable", Mode::Immutable),
+    ] {
+        assert!(need - offset >= plan.scratch_len(mode));
+        let dst = if mode == Mode::InPlace { ip } else { op };
+        let ns = sample(|| {
+            // SAFETY: validated shape and complete buffers; T is sealed to f32/f64.
+            unsafe {
+                match T::precision() {
+                    Precision::F32 => super::stockham_f32(
+                        shape,
+                        &*(&plan as *const StockhamPlan<T>).cast::<StockhamPlan<f32>>(),
+                        black_box(ip.cast()),
+                        black_box(dst.cast()),
+                        black_box(sp.cast()),
+                        mode,
+                        inverse,
+                    ),
+                    Precision::F64 => super::stockham_f64(
+                        shape,
+                        &*(&plan as *const StockhamPlan<T>).cast::<StockhamPlan<f64>>(),
+                        black_box(ip.cast()),
+                        black_box(dst.cast()),
+                        black_box(sp.cast()),
+                        mode,
+                        inverse,
+                    ),
+                }
+            }
+            black_box(dst);
+        });
+        black_box(&input);
+        black_box(&output);
+        black_box(&scratch);
+        result.push(Sample {
+            surface: "kernel",
+            placement,
+            ns,
+        });
+    }
+    result
+}
diff --git a/crates/fastfft/src/isa/x86/interleaved.rs b/crates/fastfft/src/isa/x86/interleaved.rs
new file mode 100644
index 0000000..1371ca6
--- /dev/null
+++ b/crates/fastfft/src/isa/x86/interleaved.rs
@@ -0,0 +1,623 @@
+//! Private interleaved-complex leaves for N = 2 through 128 under AVX2+FMA.
+//!
+//! Tiny transforms are latency- and shuffle-bound: the split layout pays a
+//! deinterleave and an interleave per call. These leaves keep `re, im` pairs
+//! adjacent, so every load and store is a plain 256-bit move. The Small engine
+//! owns validation, target-feature entries and batch scheduling.
+use core::arch::x86_64::*;
+
+/// Four adjacent complex values: one `__m256` for f32, two `__m256d` for f64.
+///
+/// # Safety
+///
+/// Every method requires AVX2+FMA except `leaf2` and `leaf4`, which use only
+/// SSE2 so they can inline without a target-feature call. Pointers must be
+/// valid for every scalar the method touches.
+pub(crate) unsafe trait Row: Copy {
+    type S: Copy;
+    unsafe fn load(p: *const Self::S) -> Self;
+    unsafe fn store(self, p: *mut Self::S);
+    unsafe fn add(self, o: Self) -> Self;
+    unsafe fn sub(self, o: Self) -> Self;
+    /// Multiplies every lane by 1/√2.
+    unsafe fn half_sqrt2(self) -> Self;
+    /// Multiplies by -i (forward) or +i (inverse).
+    unsafe fn rot<const INV: bool>(self) -> Self;
+    /// Complex multiply by a table row: eight duplicated real parts then eight
+    /// duplicated imaginary parts (`re re re re ...`, `im im im im ...`).
+    unsafe fn cmul(self, w: *const Self::S) -> Self;
+    /// Transposes a 4x4 block of complex values.
+    unsafe fn transpose(r: [Self; 4]) -> [Self; 4];
+    /// N=8's second stage: radix-4 across the lane pairs `(s[j], d[j])`,
+    /// j = 0..3. Result pair k2 is outputs 2·k2 and 2·k2 + 1.
+    unsafe fn pairs4<const INV: bool>(s: Self, d: Self, output: *mut Self::S);
+    /// Complete N=2 transform (identical in both directions); SSE2 only.
+    unsafe fn leaf2(input: *const Self::S, output: *mut Self::S);
+    /// Complete N=4 transform; SSE2 only.
+    unsafe fn leaf4<const INV: bool>(input: *const Self::S, output: *mut Self::S);
+}
+
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct R32(__m256);
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct R64(__m256d, __m256d);
+
+/// Swaps real and imaginary parts within each complex f32.
+const SWAP32: i32 = 0b10_11_00_01;
+/// Swaps real and imaginary parts within each complex f64 of a 128-bit lane.
+const SWAP64: i32 = 0b0101;
+
+// SAFETY: AVX2+FMA intrinsics on unaligned eight-scalar rows.
+unsafe impl Row for R32 {
+    type S = f32;
+    #[inline(always)]
+    unsafe fn load(p: *const f32) -> Self {
+        // SAFETY: caller guarantees eight readable scalars.
+        unsafe { Self(_mm256_loadu_ps(p)) }
+    }
+    #[inline(always)]
+    unsafe fn store(self, p: *mut f32) {
+        // SAFETY: caller guarantees eight writable scalars.
+        unsafe { _mm256_storeu_ps(p, self.0) }
+    }
+    #[inline(always)]
+    unsafe fn add(self, o: Self) -> Self {
+        // SAFETY: AVX enabled by the caller.
+        unsafe { Self(_mm256_add_ps(self.0, o.0)) }
+    }
+    #[inline(always)]
+    unsafe fn sub(self, o: Self) -> Self {
+        // SAFETY: AVX enabled by the caller.
+        unsafe { Self(_mm256_sub_ps(self.0, o.0)) }
+    }
+    #[inline(always)]
+    unsafe fn half_sqrt2(self) -> Self {
+        // SAFETY: AVX enabled by the caller.
+        unsafe {
+            Self(_mm256_mul_ps(
+                self.0,
+                _mm256_set1_ps(core::f32::consts::FRAC_1_SQRT_2),
+            ))
+        }
+    }
+    #[inline(always)]
+    unsafe fn rot<const INV: bool>(self) -> Self {
+        // SAFETY: AVX enabled by the caller. (re, im)·(∓i) = (±im, ∓re).
+        unsafe {
+            let sign = if INV {
+                _mm256_setr_ps(-0., 0., -0., 0., -0., 0., -0., 0.)
+            } else {
+                _mm256_setr_ps(0., -0., 0., -0., 0., -0., 0., -0.)
+            };
+            Self(_mm256_xor_ps(_mm256_permute_ps::<SWAP32>(self.0), sign))
+        }
+    }
+    #[inline(always)]
+    unsafe fn cmul(self, w: *const f32) -> Self {
+        // SAFETY: sixteen readable table scalars; AVX2+FMA enabled.
+        unsafe {
+            let swapped = _mm256_permute_ps::<SWAP32>(self.0);
+            let im = _mm256_mul_ps(swapped, _mm256_loadu_ps(w.add(8)));
+            Self(_mm256_fmaddsub_ps(self.0, _mm256_loadu_ps(w), im))
+        }
+    }
+    #[inline(always)]
+    unsafe fn transpose(r: [Self; 4]) -> [Self; 4] {
+        // SAFETY: AVX enabled by the caller. Each complex f32 is one f64 lane.
+        // Leaf code avoids closures: they would not inherit target features.
+        unsafe {
+            let (r0, r1) = (_mm256_castps_pd(r[0].0), _mm256_castps_pd(r[1].0));
+            let (r2, r3) = (_mm256_castps_pd(r[2].0), _mm256_castps_pd(r[3].0));
+            let t0 = _mm256_unpacklo_pd(r0, r1);
+            let t1 = _mm256_unpackhi_pd(r0, r1);
+            let t2 = _mm256_unpacklo_pd(r2, r3);
+            let t3 = _mm256_unpackhi_pd(r2, r3);
+            [
+                Self(_mm256_castpd_ps(lo128(t0, t2))),
+                Self(_mm256_castpd_ps(lo128(t1, t3))),
+                Self(_mm256_castpd_ps(hi128(t0, t2))),
+                Self(_mm256_castpd_ps(hi128(t1, t3))),
+            ]
+        }
+    }
+    #[inline(always)]
+    unsafe fn pairs4<const INV: bool>(s: Self, d: Self, output: *mut f32) {
+        // SAFETY: AVX enabled by the caller; sixteen writable scalars.
+        unsafe {
+            let (s, d) = (_mm256_castps_pd(s.0), _mm256_castps_pd(d.0));
+            // [s0 d0 | s2 d2] and [s1 d1 | s3 d3], one complex per f64 lane.
+            let e = fold32(_mm256_castpd_ps(_mm256_unpacklo_pd(s, d)));
+            let f = fold32(_mm256_castpd_ps(_mm256_unpackhi_pd(s, d)));
+            let f = _mm256_blend_ps::<0xF0>(f, Self(f).rot::<INV>().0);
+            _mm256_storeu_ps(output, _mm256_add_ps(e, f));
+            _mm256_storeu_ps(output.add(8), _mm256_sub_ps(e, f));
+        }
+    }
+    #[inline(always)]
+    unsafe fn leaf2(input: *const f32, output: *mut f32) {
+        // SAFETY: four readable/writable scalars; SSE2 is baseline on x86_64.
+        // One complex per 8-byte load: each lies within one earlier store.
+        unsafe {
+            let a = _mm_castpd_ps(_mm_load_sd(input.cast()));
+            let b = _mm_castpd_ps(_mm_load_sd(input.add(2).cast()));
+            _mm_store_sd(output.cast(), _mm_castps_pd(_mm_add_ps(a, b)));
+            _mm_store_sd(output.add(2).cast(), _mm_castps_pd(_mm_sub_ps(a, b)));
+        }
+    }
+    #[inline(always)]
+    unsafe fn leaf4<const INV: bool>(input: *const f32, output: *mut f32) {
+        // SAFETY: eight readable/writable scalars; SSE2 is baseline on x86_64.
+        unsafe {
+            let a = _mm_loadu_ps(input);
+            let b = _mm_loadu_ps(input.add(4));
+            let s = _mm_add_ps(a, b);
+            let d = _mm_sub_ps(a, b);
+            // [s0 d0] and [s1 d1]; rotate only d1 by ∓i.
+            let u = _mm_movelh_ps(s, d);
+            let v = _mm_movehl_ps(d, s);
+            let v = _mm_shuffle_ps::<0b10_11_01_00>(v, v);
+            let sign = if INV {
+                _mm_setr_ps(0., 0., -0., 0.)
+            } else {
+                _mm_setr_ps(0., 0., 0., -0.)
+            };
+            let v = _mm_xor_ps(v, sign);
+            _mm_storeu_ps(output, _mm_add_ps(u, v));
+            _mm_storeu_ps(output.add(4), _mm_sub_ps(u, v));
+        }
+    }
+}
+
+// SAFETY: AVX2+FMA intrinsics on unaligned eight-scalar rows.
+unsafe impl Row for R64 {
+    type S = f64;
+    #[inline(always)]
+    unsafe fn load(p: *const f64) -> Self {
+        // SAFETY: caller guarantees eight readable scalars.
+        unsafe { Self(_mm256_loadu_pd(p), _mm256_loadu_pd(p.add(4))) }
+    }
+    #[inline(always)]
+    unsafe fn store(self, p: *mut f64) {
+        // SAFETY: caller guarantees eight writable scalars.
+        unsafe {
+            _mm256_storeu_pd(p, self.0);
+            _mm256_storeu_pd(p.add(4), self.1);
+        }
+    }
+    #[inline(always)]
+    unsafe fn add(self, o: Self) -> Self {
+        // SAFETY: AVX enabled by the caller.
+        unsafe { Self(_mm256_add_pd(self.0, o.0), _mm256_add_pd(self.1, o.1)) }
+    }
+    #[inline(always)]
+    unsafe fn sub(self, o: Self) -> Self {
+        // SAFETY: AVX enabled by the caller.
+        unsafe { Self(_mm256_sub_pd(self.0, o.0), _mm256_sub_pd(self.1, o.1)) }
+    }
+    #[inline(always)]
+    unsafe fn half_sqrt2(self) -> Self {
+        // SAFETY: AVX enabled by the caller.
+        unsafe {
+            let k = _mm256_set1_pd(core::f64::consts::FRAC_1_SQRT_2);
+            Self(_mm256_mul_pd(self.0, k), _mm256_mul_pd(self.1, k))
+        }
+    }
+    #[inline(always)]
+    unsafe fn rot<const INV: bool>(self) -> Self {
+        // SAFETY: AVX enabled by the caller.
+        unsafe { Self(rot64::<INV>(self.0), rot64::<INV>(self.1)) }
+    }
+    #[inline(always)]
+    unsafe fn cmul(self, w: *const f64) -> Self {
+        // SAFETY: sixteen readable table scalars; AVX2+FMA enabled.
+        unsafe {
+            Self(
+                cmul64(self.0, _mm256_loadu_pd(w), _mm256_loadu_pd(w.add(8))),
+                cmul64(
+                    self.1,
+                    _mm256_loadu_pd(w.add(4)),
+                    _mm256_loadu_pd(w.add(12)),
+                ),
+            )
+        }
+    }
+    #[inline(always)]
+    unsafe fn transpose(r: [Self; 4]) -> [Self; 4] {
+        // SAFETY: AVX enabled by the caller. Four 2x2 blocks of 128-bit lanes.
+        unsafe {
+            [
+                Self(lo128(r[0].0, r[1].0), lo128(r[2].0, r[3].0)),
+                Self(hi128(r[0].0, r[1].0), hi128(r[2].0, r[3].0)),
+                Self(lo128(r[0].1, r[1].1), lo128(r[2].1, r[3].1)),
+                Self(hi128(r[0].1, r[1].1), hi128(r[2].1, r[3].1)),
+            ]
+        }
+    }
+    #[inline(always)]
+    unsafe fn pairs4<const INV: bool>(s: Self, d: Self, output: *mut f64) {
+        // SAFETY: AVX enabled by the caller; sixteen writable scalars.
+        unsafe {
+            let (p0, p1) = (lo128(s.0, d.0), hi128(s.0, d.0));
+            let (p2, p3) = (lo128(s.1, d.1), hi128(s.1, d.1));
+            let s02 = _mm256_add_pd(p0, p2);
+            let d02 = _mm256_sub_pd(p0, p2);
+            let s13 = _mm256_add_pd(p1, p3);
+            let d13 = rot64::<INV>(_mm256_sub_pd(p1, p3));
+            _mm256_storeu_pd(output, _mm256_add_pd(s02, s13));
+            _mm256_storeu_pd(output.add(4), _mm256_add_pd(d02, d13));
+            _mm256_storeu_pd(output.add(8), _mm256_sub_pd(s02, s13));
+            _mm256_storeu_pd(output.add(12), _mm256_sub_pd(d02, d13));
+        }
+    }
+    #[inline(always)]
+    unsafe fn leaf2(input: *const f64, output: *mut f64) {
+        // SAFETY: four readable/writable scalars; SSE2 is baseline on x86_64.
+        unsafe {
+            let a = _mm_loadu_pd(input);
+            let b = _mm_loadu_pd(input.add(2));
+            _mm_storeu_pd(output, _mm_add_pd(a, b));
+            _mm_storeu_pd(output.add(2), _mm_sub_pd(a, b));
+        }
+    }
+    #[inline(always)]
+    unsafe fn leaf4<const INV: bool>(input: *const f64, output: *mut f64) {
+        // SAFETY: eight readable/writable scalars; SSE2 is baseline on x86_64.
+        // One complex per xmm: no cross-lane shuffles on the latency path.
+        unsafe {
+            let x0 = _mm_loadu_pd(input);
+            let x1 = _mm_loadu_pd(input.add(2));
+            let x2 = _mm_loadu_pd(input.add(4));
+            let x3 = _mm_loadu_pd(input.add(6));
+            let s02 = _mm_add_pd(x0, x2);
+            let d02 = _mm_sub_pd(x0, x2);
+            let s13 = _mm_add_pd(x1, x3);
+            let t = _mm_sub_pd(x1, x3);
+            let sign = if INV {
+                _mm_setr_pd(-0., 0.)
+            } else {
+                _mm_setr_pd(0., -0.)
+            };
+            let d13 = _mm_xor_pd(_mm_shuffle_pd::<0b01>(t, t), sign);
+            _mm_storeu_pd(output, _mm_add_pd(s02, s13));
+            _mm_storeu_pd(output.add(2), _mm_add_pd(d02, d13));
+            _mm_storeu_pd(output.add(4), _mm_sub_pd(s02, s13));
+            _mm_storeu_pd(output.add(6), _mm_sub_pd(d02, d13));
+        }
+    }
+}
+
+/// Low 128-bit lanes of `a` and `b`.
+#[inline(always)]
+unsafe fn lo128(a: __m256d, b: __m256d) -> __m256d {
+    // SAFETY: AVX enabled by the caller.
+    unsafe { _mm256_permute2f128_pd::<0x20>(a, b) }
+}
+
+/// High 128-bit lanes of `a` and `b`.
+#[inline(always)]
+unsafe fn hi128(a: __m256d, b: __m256d) -> __m256d {
+    // SAFETY: AVX enabled by the caller.
+    unsafe { _mm256_permute2f128_pd::<0x31>(a, b) }
+}
+
+/// `[x.lo + x.hi | x.lo - x.hi]` for 128-bit halves of f32 lanes.
+#[inline(always)]
+unsafe fn fold32(x: __m256) -> __m256 {
+    // SAFETY: AVX enabled by the caller.
+    unsafe {
+        let neg_hi = _mm256_setr_ps(0., 0., 0., 0., -0., -0., -0., -0.);
+        _mm256_add_ps(
+            _mm256_permute2f128_ps::<0x01>(x, x),
+            _mm256_xor_ps(x, neg_hi),
+        )
+    }
+}
+
+#[inline(always)]
+unsafe fn rot64<const INV: bool>(x: __m256d) -> __m256d {
+    // SAFETY: AVX enabled by the caller.
+    unsafe {
+        let sign = if INV {
+            _mm256_setr_pd(-0., 0., -0., 0.)
+        } else {
+            _mm256_setr_pd(0., -0., 0., -0.)
+        };
+        _mm256_xor_pd(_mm256_permute_pd::<SWAP64>(x), sign)
+    }
+}
+
+#[inline(always)]
+unsafe fn cmul64(a: __m256d, wr: __m256d, wi: __m256d) -> __m256d {
+    // SAFETY: AVX2+FMA enabled by the caller.
+    unsafe { _mm256_fmaddsub_pd(a, wr, _mm256_mul_pd(_mm256_permute_pd::<SWAP64>(a), wi)) }
+}
+
+#[inline(always)]
+unsafe fn radix4<R: Row, const INV: bool>(a: [R; 4]) -> [R; 4] {
+    // SAFETY: row arithmetic under the caller's features.
+    unsafe {
+        let s02 = a[0].add(a[2]);
+        let d02 = a[0].sub(a[2]);
+        let s13 = a[1].add(a[3]);
+        let d13 = a[1].sub(a[3]).rot::<INV>();
+        [s02.add(s13), d02.add(d13), s02.sub(s13), d02.sub(d13)]
+    }
+}
+
+/// Multiplies by ω8 = (1 ∓ i)/√2, with ∓i applied by `rot`.
+#[inline(always)]
+unsafe fn mul_w8<R: Row, const INV: bool>(v: R) -> R {
+    // SAFETY: row arithmetic under the caller's features.
+    unsafe { v.add(v.rot::<INV>()).half_sqrt2() }
+}
+
+/// Multiplies by ω8³ = (-1 ∓ i)/√2.
+#[inline(always)]
+unsafe fn mul_w8_3<R: Row, const INV: bool>(v: R) -> R {
+    // SAFETY: row arithmetic under the caller's features.
+    unsafe { v.rot::<INV>().sub(v).half_sqrt2() }
+}
+
+#[inline(always)]
+unsafe fn radix8<R: Row, const INV: bool>(a: [R; 8]) -> [R; 8] {
+    // SAFETY: row arithmetic under the caller's features.
+    unsafe {
+        let e = radix4::<R, INV>([a[0], a[2], a[4], a[6]]);
+        let o = radix4::<R, INV>([a[1], a[3], a[5], a[7]]);
+        let o1 = mul_w8::<R, INV>(o[1]);
+        let o2 = o[2].rot::<INV>();
+        let o3 = mul_w8_3::<R, INV>(o[3]);
+        [
+            e[0].add(o[0]),
+            e[1].add(o1),
+            e[2].add(o2),
+            e[3].add(o3),
+            e[0].sub(o[0]),
+            e[1].sub(o1),
+            e[2].sub(o2),
+            e[3].sub(o3),
+        ]
+    }
+}
+
+/// Rows of the first stage: N = rows x cols with n = cols·n1 + n2.
+const fn rows(n: usize) -> usize {
+    match n {
+        8 => 2,
+        16 => 4,
+        _ => 8,
+    }
+}
+
+/// Table length in scalars for `leaf::<_, N, _>`.
+pub(crate) const fn table_len(n: usize) -> usize {
+    if n <= 4 {
+        return 0;
+    }
+    let groups = n / rows(n) / 4;
+    16 * groups * (rows(n) - 1) + if n == 128 { 48 } else { 0 }
+}
+
+/// Offset of the first-stage twiddle row for column group `g` and `k1 >= 1`.
+const fn tw_row(n: usize, g: usize, k1: usize) -> usize {
+    16 * (g * (rows(n) - 1) + k1 - 1)
+}
+
+/// Fills the twiddle table in `Row::cmul` layout: for each group of four
+/// columns, rows k1 = 1..rows hold ω_n^(k1·n2). N=128 appends broadcast
+/// ω16, ω16³ and ω16⁹ for its radix-16 stage. `omega(k, n)` returns
+/// (cos, sin) of the direction's angle.
+pub(crate) fn table<S: Copy>(n: usize, omega: impl Fn(usize, usize) -> (S, S)) -> Vec<S> {
+    let mut t = Vec::with_capacity(table_len(n));
+    let mut push = |w: [(S, S); 4]| {
+        t.extend(w.iter().flat_map(|&(r, _)| [r, r]));
+        t.extend(w.iter().flat_map(|&(_, i)| [i, i]));
+    };
+    if n > 4 {
+        for g in 0..n / rows(n) / 4 {
+            for k1 in 1..rows(n) {
+                push(core::array::from_fn(|j| omega(k1 * (4 * g + j), n)));
+            }
+        }
+    }
+    if n == 128 {
+        for k in [1, 3, 9] {
+            push([omega(k, 16); 4]);
+        }
+    }
+    assert_eq!(t.len(), table_len(n));
+    t
+}
+
+/// N=16 (4x4) and N=32 (8x4): columns across rows, twiddle, 4x4 transposes,
+/// then radix-4 across rows. N <= 8 use dedicated sequences. All inputs are
+/// loaded before any store.
+#[inline(always)]
+pub(crate) unsafe fn leaf<R: Row, const N: usize, const INV: bool>(
+    input: *const R::S,
+    output: *mut R::S,
+    tw: *const R::S,
+) {
+    const {
+        assert!(matches!(N, 2 | 4 | 8 | 16 | 32 | 64 | 128));
+    }
+    // SAFETY: 2N readable/writable scalars, table_len(N) table scalars and
+    // AVX2+FMA from the caller (SSE2 suffices for N <= 4). Input and output
+    // may be identical.
+    unsafe {
+        if N == 2 {
+            return R::leaf2(input, output);
+        }
+        if N == 4 {
+            return R::leaf4::<INV>(input, output);
+        }
+        if N == 8 {
+            return leaf8::<R, INV>(input, output, tw);
+        }
+        if N == 64 {
+            return leaf64::<R, INV>(input, output, tw);
+        }
+        if N == 128 {
+            return leaf128::<R, INV>(input, output, tw);
+        }
+        if N == 16 {
+            let mut a = [R::load(input); 4];
+            for (k, row) in a.iter_mut().enumerate().skip(1) {
+                *row = R::load(input.add(8 * k));
+            }
+            let mut a = radix4::<R, INV>(a);
+            for (k, row) in a.iter_mut().enumerate().skip(1) {
+                *row = row.cmul(tw.add(16 * (k - 1)));
+            }
+            let a = radix4::<R, INV>(R::transpose(a));
+            for (k, row) in a.iter().enumerate() {
+                row.store(output.add(8 * k));
+            }
+        } else {
+            let mut a = [R::load(input); 8];
+            for (k, row) in a.iter_mut().enumerate().skip(1) {
+                *row = R::load(input.add(8 * k));
+            }
+            let mut a = radix8::<R, INV>(a);
+            for (k, row) in a.iter_mut().enumerate().skip(1) {
+                *row = row.cmul(tw.add(16 * (k - 1)));
+            }
+            let x = radix4::<R, INV>(R::transpose([a[0], a[1], a[2], a[3]]));
+            let y = radix4::<R, INV>(R::transpose([a[4], a[5], a[6], a[7]]));
+            for k in 0..4 {
+                x[k].store(output.add(16 * k));
+                y[k].store(output.add(16 * k + 8));
+            }
+        }
+    }
+}
+
+/// N=8: radix-2 across two rows, one twiddled row, then a radix-4 over the
+/// four lane pairs. Each result pair is two adjacent outputs.
+#[inline(always)]
+unsafe fn leaf8<R: Row, const INV: bool>(input: *const R::S, output: *mut R::S, tw: *const R::S) {
+    // SAFETY: forwarded from `leaf`.
+    unsafe {
+        let a = R::load(input);
+        let b = R::load(input.add(8));
+        R::pairs4::<INV>(a.add(b), a.sub(b).cmul(tw), output);
+    }
+}
+
+/// First stage of an 8-row decomposition for column group `g`: radix-8 down
+/// the rows, then twiddles. Rows are `stride` scalars apart.
+#[inline(always)]
+unsafe fn columns8<R: Row, const N: usize, const INV: bool>(
+    input: *const R::S,
+    stride: usize,
+    g: usize,
+    tw: *const R::S,
+) -> [R; 8] {
+    // SAFETY: forwarded from `leaf`.
+    unsafe {
+        let mut a = [R::load(input.add(8 * g)); 8];
+        for (k, row) in a.iter_mut().enumerate().skip(1) {
+            *row = R::load(input.add(stride * k + 8 * g));
+        }
+        let mut a = radix8::<R, INV>(a);
+        for (k1, row) in a.iter_mut().enumerate().skip(1) {
+            *row = row.cmul(tw.add(tw_row(N, g, k1)));
+        }
+        a
+    }
+}
+
+/// N=64 (8x8), register-resident: two column groups, four 4x4 transposes,
+/// then radix-8 across the transposed rows.
+#[inline(always)]
+unsafe fn leaf64<R: Row, const INV: bool>(input: *const R::S, output: *mut R::S, tw: *const R::S) {
+    // SAFETY: forwarded from `leaf`; every load precedes every store.
+    unsafe {
+        let m0 = columns8::<R, 64, INV>(input, 16, 0, tw);
+        let m1 = columns8::<R, 64, INV>(input, 16, 1, tw);
+        let a = R::transpose([m0[0], m0[1], m0[2], m0[3]]);
+        let b = R::transpose([m0[4], m0[5], m0[6], m0[7]]);
+        let c = R::transpose([m1[0], m1[1], m1[2], m1[3]]);
+        let d = R::transpose([m1[4], m1[5], m1[6], m1[7]]);
+        let lo = radix8::<R, INV>([a[0], a[1], a[2], a[3], c[0], c[1], c[2], c[3]]);
+        let hi = radix8::<R, INV>([b[0], b[1], b[2], b[3], d[0], d[1], d[2], d[3]]);
+        for k in 0..8 {
+            lo[k].store(output.add(16 * k));
+            hi[k].store(output.add(16 * k + 8));
+        }
+    }
+}
+
+/// N=128 (8 rows x 16 columns) in two passes through a stack buffer: radix-8
+/// columns with twiddles and transposes, then radix-16 across 16 rows.
+#[inline(always)]
+unsafe fn leaf128<R: Row, const INV: bool>(input: *const R::S, output: *mut R::S, tw: *const R::S) {
+    // SAFETY: forwarded from `leaf`. The first pass reads only the input and
+    // writes only the stack buffer, so input and output may be identical.
+    unsafe {
+        let mut mid = core::mem::MaybeUninit::<[R::S; 256]>::uninit();
+        let mid = mid.as_mut_ptr().cast::<R::S>();
+        for g in 0..4 {
+            let m = columns8::<R, 128, INV>(input, 32, g, tw);
+            let lo = R::transpose([m[0], m[1], m[2], m[3]]);
+            let hi = R::transpose([m[4], m[5], m[6], m[7]]);
+            for j in 0..4 {
+                lo[j].store(mid.add(16 * (4 * g + j)));
+                hi[j].store(mid.add(16 * (4 * g + j) + 8));
+            }
+        }
+        let w = tw.add(tw_row(128, 3, 7) + 16);
+        for h in 0..2 {
+            let mut x = [R::load(mid.add(8 * h)); 16];
+            for (n2, row) in x.iter_mut().enumerate().skip(1) {
+                *row = R::load(mid.add(16 * n2 + 8 * h));
+            }
+            let z = radix16::<R, INV>(x, w);
+            for (k2, row) in z.iter().enumerate() {
+                row.store(output.add(16 * k2 + 8 * h));
+            }
+        }
+    }
+}
+
+/// Radix-16 across rows as 4x4: `w` holds broadcast ω16, ω16³ and ω16⁹.
+#[inline(always)]
+unsafe fn radix16<R: Row, const INV: bool>(x: [R; 16], w: *const R::S) -> [R; 16] {
+    // SAFETY: row arithmetic under the caller's features; 48 table scalars.
+    unsafe {
+        let y0 = radix4::<R, INV>([x[0], x[4], x[8], x[12]]);
+        let y1 = radix4::<R, INV>([x[1], x[5], x[9], x[13]]);
+        let y2 = radix4::<R, INV>([x[2], x[6], x[10], x[14]]);
+        let y3 = radix4::<R, INV>([x[3], x[7], x[11], x[15]]);
+        // ω16^(b·c): 1, 2 and 3 for b = 1; 2, 4 and 6 for b = 2; 3, 6, 9.
+        let y = [
+            y0,
+            [
+                y1[0],
+                y1[1].cmul(w),
+                mul_w8::<R, INV>(y1[2]),
+                y1[3].cmul(w.add(16)),
+            ],
+            [
+                y2[0],
+                mul_w8::<R, INV>(y2[1]),
+                y2[2].rot::<INV>(),
+                mul_w8_3::<R, INV>(y2[3]),
+            ],
+            [
+                y3[0],
+                y3[1].cmul(w.add(16)),
+                mul_w8_3::<R, INV>(y3[2]),
+                y3[3].cmul(w.add(32)),
+            ],
+        ];
+        let mut z = [x[0]; 16];
+        for c in 0..4 {
+            let r = radix4::<R, INV>([y[0][c], y[1][c], y[2][c], y[3][c]]);
+            for d in 0..4 {
+                z[c + 4 * d] = r[d];
+            }
+        }
+        z
+    }
+}
