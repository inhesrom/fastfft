+            ),
+            3 => r3::sn3(
+                &mut *(re as *mut [V; R]).cast::<[V; 3]>(),
+                &mut *(im as *mut [V; R]).cast::<[V; 3]>(),
+            ),
+            4 => r4::sn4(
+                &mut *(re as *mut [V; R]).cast::<[V; 4]>(),
+                &mut *(im as *mut [V; R]).cast::<[V; 4]>(),
+            ),
+            5 => r5::sn5(
+                &mut *(re as *mut [V; R]).cast::<[V; 5]>(),
+                &mut *(im as *mut [V; R]).cast::<[V; 5]>(),
+            ),
+            6 => r6::sn6(
+                &mut *(re as *mut [V; R]).cast::<[V; 6]>(),
+                &mut *(im as *mut [V; R]).cast::<[V; 6]>(),
+            ),
+            7 => r7::sn7(
