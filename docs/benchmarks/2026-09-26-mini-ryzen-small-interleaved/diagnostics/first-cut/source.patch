+#[test]
+fn specialized_plans_cache_describe_measure_and_reject_invalid_buffers() {
+    use fastfft::PlanMode;
+    use std::panic::{AssertUnwindSafe, catch_unwind};
+    use std::time::Duration;
+    for mode in [
+        PlanMode::Estimate,
+        PlanMode::Measure {
+            time_limit: Duration::from_millis(2),
+        },
+    ] {
+        let mut p = FftPlanner::<f64>::with_options(PlannerOptions::default().with_mode(mode));
+        for n in [0, 1, 2, 3, 8, 16, 17, 19, 32, 64, 128, 256, 512] {
+            for dir in [FftDirection::Forward, FftDirection::Inverse] {
+                let f = p.plan_fft(n, dir);
+                let desc = p.describe_plan(n, dir);
+                assert!(Arc::ptr_eq(&f, &p.plan_fft(n, dir)));
+                assert_eq!(f.len(), n);
+                assert_eq!(f.fft_direction(), dir);
+                if desc.starts_with("small") {
+                    assert!(
+                        desc.contains("decomposition=") && desc.contains("scratch=0"),
+                        "{desc}"
+                    );
+                    assert_eq!(f.get_inplace_scratch_len(), 0);
+                    assert_eq!(f.get_outofplace_scratch_len(), 0);
+                    assert_eq!(f.get_immutable_scratch_len(), 0);
+                }
+                if n < 2 {
+                    continue;
+                }
+                for len in [0, n - 1, n + 1] {
+                    let mut a = zeros::<f64>(len);
+                    let mut b = zeros::<f64>(len);
+                    let mut scratch = zeros(
+                        f.get_inplace_scratch_len()
+                            .max(f.get_immutable_scratch_len()),
+                    );
+                    assert!(
+                        catch_unwind(AssertUnwindSafe(
+                            || f.process_with_scratch(&mut a, &mut scratch)
+                        ))
+                        .is_err()
+                    );
+                    assert!(
+                        catch_unwind(AssertUnwindSafe(|| f.process_outofplace_with_scratch(
+                            &mut a,
+                            &mut b,
+                            &mut scratch
+                        )))
+                        .is_err()
+                    );
+                    assert!(
+                        catch_unwind(AssertUnwindSafe(|| f.process_immutable_with_scratch(
+                            &a,
+                            &mut b,
+                            &mut scratch
+                        )))
+                        .is_err()
+                    );
+                }
+            }
+        }
+    }
+}
diff --git a/crates/fastfft/src/diagnostic.rs b/crates/fastfft/src/diagnostic.rs
new file mode 100644
index 0000000..0b3a002
--- /dev/null
+++ b/crates/fastfft/src/diagnostic.rs
@@ -0,0 +1,313 @@
+//! Test-only latency harness. Filters are comma-separated FASTFFT_TIMING_{N,
+//! PRECISION,CANDIDATE,SURFACE}; candidates use kernel:isa:lanes (or kernel).
+//! No filter retains the original sizes/precisions/candidates and adds RustFFT.
+
+use crate::api::{Fft, FftDirection, FftNum};
+use crate::isa::{Isa, Precision, detected_isa};
+use crate::planner::{build_candidate, candidates};
+use fastfft_testkit::{Dir, error_vs_dd, random_c64, reference_dd};
+use num_complex::Complex;
+use std::hint::black_box;
+use std::time::{Duration, Instant};
+
+pub(crate) fn enabled(filter: &str, value: &str) -> bool {
+    std::env::var(format!("FASTFFT_TIMING_{filter}")).map_or(true, |s| {
+        s.split(',')
+            .any(|x| x == value || value.starts_with(&format!("{x}:")))
+    })
+}
+
+#[derive(Debug)]
+pub(crate) struct Sample {
+    pub surface: &'static str,
+    pub placement: &'static str,
+    pub ns: [f64; 2],
+}
+
+pub(crate) fn addresses<T>(wrapper: usize, entry: usize) {
+    if std::env::var_os("FASTFFT_TIMING_SYMBOLS").is_none() {
+        return;
+    }
+    #[cfg(target_os = "linux")]
+    {
+        let exe = std::env::current_exe().unwrap();
+        let maps = std::fs::read_to_string("/proc/self/maps").unwrap();
+        let base = maps
+            .lines()
+            .find_map(|line| {
+                let p: Vec<_> = line.split_whitespace().collect();
+                (p.len() >= 6 && p[2] == "00000000" && p[5] == exe.to_str().unwrap())
+                    .then(|| usize::from_str_radix(p[0].split('-').next().unwrap(), 16).unwrap())
+            })
+            .unwrap();
+        eprintln!(
+            "symbols,{},{:#x},{:#x}",
+            std::any::type_name::<T>(),
+            wrapper - base,
+            entry - base
+        );
+    }
+    #[cfg(not(target_os = "linux"))]
+    let _ = (wrapper, entry);
+}
+
+pub(crate) fn sample(mut call: impl FnMut()) -> [f64; 2] {
+    let mut times = Vec::new();
+    let start = Instant::now();
+    while start.elapsed() < Duration::from_millis(12) {
+        let t = Instant::now();
+        for _ in 0..1024 {
+            call();
+        }
+        times.push(t.elapsed().as_nanos() as f64 / 1024.0);
+    }
+    times.sort_by(f64::total_cmp);
+    [times[0], times[times.len() / 2]]
+}
+
+pub(crate) fn verify<T: FftNum>(f: &dyn Fft<T>) {
+    let n = f.len();
+    let mut x: Vec<_> = random_c64(n, 177)
+        .into_iter()
+        .map(|z| Complex::new(T::from_f64(z.re).unwrap(), T::from_f64(z.im).unwrap()))
+        .collect();
+    let saved = x.clone();
+    let widen = |b: &[Complex<T>]| {
+        b.iter()
+            .map(|z| Complex::new(z.re.to_f64().unwrap(), z.im.to_f64().unwrap()))
+            .collect::<Vec<_>>()
+    };
+    let reference = reference_dd(
+        &widen(&x),
+        if f.fft_direction() == FftDirection::Forward {
+            Dir::Forward
+        } else {
+            Dir::Inverse
+        },
+    );
+    let mut scratch = vec![
+        Complex::new(T::zero(), T::zero());
+        f.get_inplace_scratch_len()
+            .max(f.get_outofplace_scratch_len())
+            .max(f.get_immutable_scratch_len())
+    ];
+    let mut out = x.clone();
+    for mode in 0..3 {
+        x.copy_from_slice(&saved);
+        match mode {
+            0 => {
+                f.process_with_scratch(&mut x, &mut scratch);
+                out.copy_from_slice(&x);
+            }
+            1 => f.process_outofplace_with_scratch(&mut x, &mut out, &mut scratch),
+            _ => {
+                f.process_immutable_with_scratch(&x, &mut out, &mut scratch);
+                assert_eq!(x, saved);
+            }
+        }
+        let error = error_vs_dd(&widen(&out), &reference).rel_l2 / T::epsilon().to_f64().unwrap();
+        assert!(
+            error.is_finite() && error <= 2.0 * (n as f64).log2() + 2.0,
+            "n={n} mode={mode}: {error}"
+        );
+    }
+}
+
+pub(crate) fn wrapper<T: FftNum, F: Fft<T> + ?Sized>(f: &F, surface: &'static str) -> Vec<Sample> {
+    if !enabled("SURFACE", surface) {
+        return Vec::new();
+    }
+    let zero = Complex::new(T::zero(), T::zero());
+    let mut input = vec![zero; f.len()];
+    let mut output = input.clone();
+    let mut scratch = vec![
+        zero;
+        f.get_inplace_scratch_len()
+            .max(f.get_outofplace_scratch_len())
+            .max(f.get_immutable_scratch_len())
+    ];
+    let mut result = Vec::new();
+    for placement in ["ip", "op", "immutable"] {
+        // No resets in the timed loop: IP is a dependency chain; Small OP reads
+        // the same input each time. Both buffers cross compiler barriers.
+        let ns = match placement {
+            "ip" => sample(|| {
+                f.process_with_scratch(black_box(&mut input), black_box(&mut scratch));
+                black_box(&input);
+            }),
+            "op" => sample(|| {
+                f.process_outofplace_with_scratch(
+                    black_box(&mut input),
+                    black_box(&mut output),
+                    black_box(&mut scratch),
+                );
+                black_box(&output);
+            }),
+            _ => sample(|| {
+                f.process_immutable_with_scratch(
+                    black_box(&input),
+                    black_box(&mut output),
+                    black_box(&mut scratch),
+                );
+                black_box(&output);
+            }),
+        };
+        result.push(Sample {
+            surface,
+            placement,
+            ns,
+        });
+    }
+    result
+}
+
+pub(crate) fn run<T: FftNum + rustfft::FftNum>() {
+    let precision = if T::precision() == Precision::F64 {
+        "f64"
+    } else {
+        "f32"
+    };
+    if !enabled("PRECISION", precision) {
+        return;
+    }
+    let pid = std::process::id();
+    for n in (2..=16).chain([24, 32, 40, 48, 56, 64, 128, 256]) {
+        if !enabled("N", &n.to_string()) {
+            continue;
+        }
+        let mut cs = candidates(n, detected_isa(), precision == "f64");
+        for c in candidates(n, Isa::Avx2.min(detected_isa()), precision == "f64") {
+            if !cs
+                .iter()
+                .any(|x| x.kernel == c.kernel && x.shape == c.shape && x.radices == c.radices)
+            {
+                cs.push(c);
+            }
+        }
+        for c in cs {
+            let identity = format!("{}:{}:{}", c.kernel.name(), c.shape.isa, c.shape.lanes);
+            if !enabled("CANDIDATE", &identity) {
+                continue;
+            }
+            for dir in [FftDirection::Forward, FftDirection::Inverse] {
+                let f = black_box(build_candidate::<T>(n, dir, &c));
+                verify(f.as_ref());
+                let mut samples = wrapper(black_box(f.as_ref()), "public");
+                if c.kernel == crate::planner::CandidateKernel::InterleavedSmall {
+                    // Public surface only: the leaf has no separate wrapper.
+                } else if c.kernel.is_small() {
+                    samples.extend(crate::engine::small::timings::<T>(
+                        n,
+                        dir,
+                        c.shape,
+                        c.kernel == crate::planner::CandidateKernel::SpecializedSmall,
+                    ));
+                } else {
+                    samples.extend(
+                        crate::engine::fixed::timings::<T>(n, dir, c.shape, &c.radices)
+                            .unwrap_or_else(|| {
+                                crate::engine::timing::stockham::<T>(n, dir, c.shape, &c.radices)
+                            }),
+                    );
+                }
+                for s in samples {
+                    eprintln!(
+                        "timing,{pid},{precision},{n},{},{},{},{}x{},{dir},{},{},{:.6},{:.6}",
+                        c.kernel.name(),
+                        c.shape.isa,
+                        c.shape.lanes,
+                        n / c.shape.lanes,
+                        c.shape.lanes,
+                        s.placement,
+                        s.surface,
+                        s.ns[0],
+                        s.ns[1]
+                    );
+                }
+            }
+        }
+        if enabled("CANDIDATE", "rustfft") && enabled("SURFACE", "public") {
+            for dir in [FftDirection::Forward, FftDirection::Inverse] {
+                let rd = if dir == FftDirection::Forward {
+                    rustfft::FftDirection::Forward
+                } else {
+                    rustfft::FftDirection::Inverse
+                };
+                let f = black_box(rustfft::FftPlanner::<T>::new().plan_fft(n, rd));
+                let zero = Complex::new(T::zero(), T::zero());
+                let x: Vec<_> = random_c64(n, 177)
+                    .into_iter()
+                    .map(|z| Complex::new(T::from_f64(z.re).unwrap(), T::from_f64(z.im).unwrap()))
+                    .collect();
+                let widen = |x: &[Complex<T>]| {
+                    x.iter()
+                        .map(|z| Complex::new(z.re.to_f64().unwrap(), z.im.to_f64().unwrap()))
+                        .collect::<Vec<_>>()
+                };
+                let reference = reference_dd(
+                    &widen(&x),
+                    if dir == FftDirection::Forward {
+                        Dir::Forward
+                    } else {
+                        Dir::Inverse
+                    },
+                );
+                let mut work = vec![
+                    zero;
+                    f.get_inplace_scratch_len()
+                        .max(f.get_outofplace_scratch_len())
+                        .max(f.get_immutable_scratch_len())
+                ];
+                for placement in ["ip", "op", "immutable"] {
+                    let mut input = x.clone();
+                    let mut output = x.clone();
+                    match placement {
+                        "ip" => {
+                            f.process_with_scratch(&mut input, &mut work);
+                            output.copy_from_slice(&input);
+                        }
+                        "op" => {
+                            f.process_outofplace_with_scratch(&mut input, &mut output, &mut work)
+                        }
+                        _ => {
+                            f.process_immutable_with_scratch(&input, &mut output, &mut work);
+                            assert_eq!(input, x);
+                        }
+                    }
+                    let e = error_vs_dd(&widen(&output), &reference).rel_l2
+                        / T::epsilon().to_f64().unwrap();
+                    assert!(e.is_finite() && e <= 2.0 * (n as f64).log2() + 2.0);
+                    input.fill(zero);
+                    output.fill(zero);
+                    work.fill(zero);
+                    let ns = match placement {
+                        "ip" => sample(|| {
+                            f.process_with_scratch(black_box(&mut input), black_box(&mut work));
+                            black_box(&input);
+                        }),
+                        "op" => sample(|| {
+                            f.process_outofplace_with_scratch(
+                                black_box(&mut input),
+                                black_box(&mut output),
+                                black_box(&mut work),
+                            );
+                            black_box(&output);
+                        }),
+                        _ => sample(|| {
+                            f.process_immutable_with_scratch(
+                                black_box(&input),
+                                black_box(&mut output),
+                                black_box(&mut work),
+                            );
+                            black_box(&output);
+                        }),
+                    };
+                    eprintln!(
+                        "timing,{pid},{precision},{n},rustfft,auto,0,auto,{dir},{placement},public,{:.6},{:.6}",
+                        ns[0], ns[1]
+                    );
+                }
+            }
+        }
+    }
+}
diff --git a/crates/fastfft/src/engine/fixed.rs b/crates/fastfft/src/engine/fixed.rs
new file mode 100644
index 0000000..4c6294d
--- /dev/null
+++ b/crates/fastfft/src/engine/fixed.rs
@@ -0,0 +1,462 @@
+//! Length-specialized Stockham execution for the small-range transition.
+//! Keeps the balanced arithmetic and caller scratch contract of Stockham;
+//! only pass scheduling, ISA and direction dispatch move to planning.
+
+// Without a compiled x86 tier only the build() fallback is reachable.
+#![cfg_attr(
+    not(all(
+        target_arch = "x86_64",
+        any(feature = "sse2", feature = "avx2", feature = "avx512")
+    )),
+    allow(dead_code, unused_imports, unused_macros, unused_variables)
+)]
+
+use super::Shape;
+use super::stockham::{self, Mode, StockhamPlan};
+use crate::api::{Direction, Fft, FftDirection, FftNum, Length};
+use crate::fft::{align_slack, fail_inplace, fail_outofplace};
+use crate::isa::{Isa, Precision, Vector};
+use num_complex::Complex;
+use std::marker::PhantomData;
+use std::sync::Arc;
+
+#[cfg(test)]
+mod timing;
+#[cfg(test)]
+pub(crate) use timing::timings;
+
+trait FixedVector: Vector + Send + Sync + 'static {
+    /// Matching features; complete buffers for count transforms, and aligned
+    /// scratch for N complex values (except OutOfPlace, which needs none).
+    unsafe fn run<const N: usize, const L: usize, const A: usize, const B: usize, const INV: bool>(
+        plan: &StockhamPlan<Self::S>,
+        input: *mut Self::S,
+        output: *mut Self::S,
+        scratch: *mut Self::S,
+        count: usize,
+        mode: Mode,
+    );
+}
+
+#[inline(always)]
+unsafe fn run<
+    V: Vector,
+    const N: usize,
+    const L: usize,
+    const A: usize,
+    const B: usize,
+    const INV: bool,
+>(
+    plan: &StockhamPlan<V::S>,
+    mut input: *mut V::S,
+    mut output: *mut V::S,
+    scratch: *mut V::S,
+    count: usize,
+    mode: Mode,
+) {
+    // SAFETY: matching shape, tables, features and buffers supplied by caller.
+    // Phase A uses the same buffer choreography as generic Stockham. Two
+    // passes are sufficient for these shapes; no oversized register arrays.
+    unsafe {
+        let one = V::splat_f64(core::ptr::read_volatile(&1.0f64));
+        for _ in 0..count {
+            let src;
+            if B == 1 {
+                src = if mode == Mode::OutOfPlace {
+                    input
+                } else {
+                    scratch
+                };
+                stockham::pass::<V, A, true, INV>(
+                    input,
+                    src,
+                    N / L,
+                    1,
+                    plan.pass_tw[0].as_ptr(),
+                    one,
+                );
+            } else {
+                let first = if mode == Mode::InPlace {
+                    scratch
+                } else {
+                    output
+                };
+                src = if mode == Mode::OutOfPlace {
+                    input
+                } else {
+                    scratch
+                };
+                stockham::pass::<V, A, true, INV>(
+                    input,
+                    first,
+                    N / L,
+                    1,
+                    plan.pass_tw[0].as_ptr(),
+                    one,
+                );
+                stockham::pass::<V, B, false, false>(
+                    first,
+                    src,
+                    N / L,
+                    A,
+                    plan.pass_tw[1].as_ptr(),
+                    one,
+                );
+            }
+            stockham::phase_b_blocks::<V, L, false, false, INV, false>(
+                src,
+                output,
+                N / L,
+                plan.vtw.as_ptr(),
+                one,
+            );
+            if !(N / L).is_multiple_of(L) {
+                stockham::phase_b_blocks::<V, L, false, false, INV, true>(
+                    src,
+                    output,
+                    N / L,
+                    plan.vtw.as_ptr(),
+                    one,
+                );
+            }
+            input = input.add(2 * N);
+            output = output.add(2 * N);
+        }
+    }
+}
+
+#[allow(unused_macros)]
+macro_rules! vector {
+    ($v:ty, $features:literal) => {
+        impl FixedVector for $v {
+            #[target_feature(enable=$features)]
+            unsafe fn run<
+                const N: usize,
+                const L: usize,
+                const A: usize,
+                const B: usize,
+                const INV: bool,
+            >(
+                plan: &StockhamPlan<Self::S>,
+                input: *mut Self::S,
+                output: *mut Self::S,
+                scratch: *mut Self::S,
+                count: usize,
+                mode: Mode,
+            ) {
+                // SAFETY: matching features and forwarded pointer contract.
+                unsafe { run::<Self, N, L, A, B, INV>(plan, input, output, scratch, count, mode) }
+            }
+        }
+    };
+}
+#[cfg(all(target_arch = "x86_64", feature = "sse2"))]
+vector!(crate::isa::x86::F32x4, "sse2");
+#[cfg(all(target_arch = "x86_64", feature = "sse2"))]
+vector!(crate::isa::x86::F64x2, "sse2");
+#[cfg(all(target_arch = "x86_64", feature = "avx2"))]
+vector!(crate::isa::x86::F32x8, "avx2,fma");
+#[cfg(all(target_arch = "x86_64", feature = "avx2"))]
+vector!(crate::isa::x86::F64x4, "avx2,fma");
+#[cfg(all(target_arch = "x86_64", feature = "avx512"))]
+vector!(
+    crate::isa::x86::F32x8v,
+    "avx512f,avx512vl,avx512dq,avx512bw,avx512cd,avx2,fma"
+);
+#[cfg(all(target_arch = "x86_64", feature = "avx512"))]
+vector!(
+    crate::isa::x86::F64x4v,
+    "avx512f,avx512vl,avx512dq,avx512bw,avx512cd,avx2,fma"
+);
+#[cfg(all(target_arch = "x86_64", feature = "avx512"))]
+vector!(
+    crate::isa::x86::F32x16,
+    "avx512f,avx512vl,avx512dq,avx512bw,avx512cd,avx2,fma"
+);
+#[cfg(all(target_arch = "x86_64", feature = "avx512"))]
+vector!(
+    crate::isa::x86::F64x8,
+    "avx512f,avx512vl,avx512dq,avx512bw,avx512cd,avx2,fma"
+);
+
+struct Fixed<T, V, const N: usize, const L: usize, const A: usize, const B: usize, const INV: bool>
+{
+    plan: StockhamPlan<T>,
+    vector: PhantomData<V>,
+}
+impl<T, V, const N: usize, const L: usize, const A: usize, const B: usize, const INV: bool> Length
+    for Fixed<T, V, N, L, A, B, INV>
+{
+    fn len(&self) -> usize {
+        N
+    }
+}
+impl<T, V, const N: usize, const L: usize, const A: usize, const B: usize, const INV: bool>
+    Direction for Fixed<T, V, N, L, A, B, INV>
+{
+    fn fft_direction(&self) -> FftDirection {
+        if INV {
+            FftDirection::Inverse
+        } else {
+            FftDirection::Forward
+        }
+    }
+}
+impl<
+    T: FftNum,
+    V: FixedVector,
+    const N: usize,
+    const L: usize,
+    const A: usize,
+    const B: usize,
+    const INV: bool,
+> Fixed<T, V, N, L, A, B, INV>
+{
+    unsafe fn execute(
+        &self,
+        input: *mut Complex<T>,
+        output: *mut Complex<T>,
+        scratch: &mut [Complex<T>],
+        count: usize,
+        mode: Mode,
+    ) {
+        let sp = scratch.as_mut_ptr();
+        let offset = if scratch.is_empty() {
+            0
+        } else {
+            // A legal Complex<T> slice can be aligned only to T. If its
+            // address cannot reach 64-byte alignment in whole complex steps,
+            // align_offset returns usize::MAX. As in generic Stockham, keep
+            // the offset within the reserved slack and use unaligned SIMD.
+            sp.align_offset(64).min(align_slack::<T>())
+        };
+        // SAFETY: public entry checks scratch including alignment slack and
+        // complete disjoint/aliased buffers. Constructor checks T=V::S and ISA.
+        unsafe {
+            V::run::<N, L, A, B, INV>(
+                &*(&self.plan as *const StockhamPlan<T>).cast::<StockhamPlan<V::S>>(),
+                input.cast(),
+                output.cast(),
+                sp.add(offset).cast(),
+                count,
+                mode,
+            );
+        }
+    }
+}
+impl<
+    T: FftNum,
+    V: FixedVector,
+    const N: usize,
+    const L: usize,
+    const A: usize,
+    const B: usize,
+    const INV: bool,
+> Fft<T> for Fixed<T, V, N, L, A, B, INV>
+{
+    fn process_with_scratch(&self, buffer: &mut [Complex<T>], scratch: &mut [Complex<T>]) {
+        let need = self.get_inplace_scratch_len();
+        if buffer.len() < N || !buffer.len().is_multiple_of(N) || scratch.len() < need {
+            fail_inplace(N, buffer.len(), need, scratch.len());
+        }
+        // SAFETY: complete chunks and exact scratch, input equals output.
+        unsafe {
+            self.execute(
+                buffer.as_mut_ptr(),
+                buffer.as_mut_ptr(),
+                &mut scratch[..need],
+                buffer.len() / N,
+                Mode::InPlace,
+            );
+        }
+    }
+    fn process_outofplace_with_scratch(
+        &self,
+        input: &mut [Complex<T>],
+        output: &mut [Complex<T>],
+        _: &mut [Complex<T>],
+    ) {
+        if input.len() != output.len() || input.len() < N || !input.len().is_multiple_of(N) {
+            fail_outofplace(N, input.len(), output.len(), 0, 0);
+        }
+        // SAFETY: complete disjoint chunks, no scratch required.
+        unsafe {
+            self.execute(
+                input.as_mut_ptr(),
+                output.as_mut_ptr(),
+                &mut [],
+                input.len() / N,
+                Mode::OutOfPlace,
+            );
+        }
+    }
+    fn process_immutable_with_scratch(
+        &self,
+        input: &[Complex<T>],
+        output: &mut [Complex<T>],
+        scratch: &mut [Complex<T>],
+    ) {
+        let need = self.get_immutable_scratch_len();
+        if input.len() != output.len()
+            || input.len() < N
+            || !input.len().is_multiple_of(N)
+            || scratch.len() < need
+        {
+            fail_outofplace(N, input.len(), output.len(), need, scratch.len());
+        }
+        // SAFETY: complete disjoint chunks and exact scratch. Immutable mode
+        // only writes output/scratch, never through the cast input pointer.
+        unsafe {
+            self.execute(
+                input.as_ptr().cast_mut(),
+                output.as_mut_ptr(),
+                &mut scratch[..need],
+                input.len() / N,
+                Mode::Immutable,
+            );
+        }
+    }
+    fn get_inplace_scratch_len(&self) -> usize {
+        N + align_slack::<T>()
+    }
+    fn get_outofplace_scratch_len(&self) -> usize {
+        0
+    }
+    fn get_immutable_scratch_len(&self) -> usize {
+        N + align_slack::<T>()
+    }
+}
+
+trait Factory<T: FftNum> {
+    type Output;
+    fn make<
+        V: FixedVector,
+        const N: usize,
+        const L: usize,
+        const A: usize,
+        const B: usize,
+        const INV: bool,
+    >(
+        plan: Fixed<T, V, N, L, A, B, INV>,
+    ) -> Self::Output;
+}
+struct PlanFactory;
+impl<T: FftNum> Factory<T> for PlanFactory {
+    type Output = Arc<dyn Fft<T>>;
+    fn make<
+        V: FixedVector,
+        const N: usize,
+        const L: usize,
+        const A: usize,
+        const B: usize,
+        const INV: bool,
+    >(
+        plan: Fixed<T, V, N, L, A, B, INV>,
+    ) -> Self::Output {
+        Arc::new(plan)
+    }
+}
+
+fn sized<
+    T: FftNum,
+    V: FixedVector,
+    F: Factory<T>,
+    const N: usize,
+    const L: usize,
+    const A: usize,
+    const B: usize,
+>(
+    dir: FftDirection,
+) -> F::Output {
+    assert_eq!(size_of::<T>(), size_of::<V::S>());
+    assert_eq!(V::LANES, L);
+    assert_eq!(N, L * A * B);
+    let plan = StockhamPlan::new(N, L, if B == 1 { vec![A] } else { vec![A, B] });
+    if dir == FftDirection::Inverse {
+        F::make(Fixed::<T, V, N, L, A, B, true> {
+            plan,
+            vector: PhantomData,
+        })
+    } else {
+        F::make(Fixed::<T, V, N, L, A, B, false> {
+            plan,
+            vector: PhantomData,
+        })
+    }
+}
+
+fn for_vector<T: FftNum, V: FixedVector, F: Factory<T>>(
+    n: usize,
+    dir: FftDirection,
+    radices: &[usize],
+) -> Option<F::Output> {
+    macro_rules! go {
+        ($n:literal,$l:literal,$a:literal,$b:literal) => {
+            Some(sized::<T, V, F, $n, $l, $a, $b>(dir))
+        };
+    }
+    match (n, V::LANES, radices) {
+        (32, 2, [8, 2]) => go!(32, 2, 8, 2),
+        (32, 4, [8]) => go!(32, 4, 8, 1),
+        (32, 8, [4]) => go!(32, 8, 4, 1),
+        (32, 16, [2]) => go!(32, 16, 2, 1),
+        (64, 2, [8, 4]) => go!(64, 2, 8, 4),
+        (64, 4, [8, 2]) => go!(64, 4, 8, 2),
+        (64, 8, [8]) => go!(64, 8, 8, 1),
+        (64, 16, [4]) => go!(64, 16, 4, 1),
+        (128, 2, [8, 8]) => go!(128, 2, 8, 8),
+        (128, 4, [8, 4]) => go!(128, 4, 8, 4),
+        (128, 8, [8, 2]) => go!(128, 8, 8, 2),
+        (128, 16, [8]) => go!(128, 16, 8, 1),
+        (256, 4, [8, 8]) => go!(256, 4, 8, 8),
+        (256, 8, [8, 4]) => go!(256, 8, 8, 4),
+        (256, 16, [8, 2]) => go!(256, 16, 8, 2),
+        _ => None,
+    }
+}
+
+pub(crate) fn build<T: FftNum>(
+    n: usize,
+    dir: FftDirection,
+    shape: Shape,
+    radices: &[usize],
+) -> Option<Arc<dyn Fft<T>>> {
+    build_with::<T, PlanFactory>(n, dir, shape, radices)
+}
+
+fn build_with<T: FftNum, F: Factory<T>>(
+    n: usize,
+    dir: FftDirection,
+    shape: Shape,
+    radices: &[usize],
+) -> Option<F::Output> {
+    if !matches!(n, 32 | 64 | 128 | 256) || shape.isa == Isa::Scalar {
+        return None;
+    }
+    assert!(crate::isa::available(shape.isa));
+    macro_rules! go {
+        ($v:ty) => {{
+            assert_eq!(shape.lanes, <$v as Vector>::LANES);
+            for_vector::<T, $v, F>(n, dir, radices)
+        }};
+    }
+    match (T::precision(), shape.isa) {
+        #[cfg(all(target_arch = "x86_64", feature = "sse2"))]
+        (Precision::F32, Isa::Sse2) => go!(crate::isa::x86::F32x4),
+        #[cfg(all(target_arch = "x86_64", feature = "sse2"))]
+        (Precision::F64, Isa::Sse2) => go!(crate::isa::x86::F64x2),
+        #[cfg(all(target_arch = "x86_64", feature = "avx2"))]
+        (Precision::F32, Isa::Avx2) => go!(crate::isa::x86::F32x8),
+        #[cfg(all(target_arch = "x86_64", feature = "avx2"))]
+        (Precision::F64, Isa::Avx2) => go!(crate::isa::x86::F64x4),
+        #[cfg(all(target_arch = "x86_64", feature = "avx512"))]
+        (Precision::F32, Isa::Avx512Ymm) => go!(crate::isa::x86::F32x8v),
+        #[cfg(all(target_arch = "x86_64", feature = "avx512"))]
+        (Precision::F64, Isa::Avx512Ymm) => go!(crate::isa::x86::F64x4v),
+        #[cfg(all(target_arch = "x86_64", feature = "avx512"))]
+        (Precision::F32, Isa::Avx512) => go!(crate::isa::x86::F32x16),
+        #[cfg(all(target_arch = "x86_64", feature = "avx512"))]
+        (Precision::F64, Isa::Avx512) => go!(crate::isa::x86::F64x8),
+        _ => None,
+    }
+}
diff --git a/crates/fastfft/src/engine/fixed/timing.rs b/crates/fastfft/src/engine/fixed/timing.rs
new file mode 100644
index 0000000..b5b03be
--- /dev/null
+++ b/crates/fastfft/src/engine/fixed/timing.rs
@@ -0,0 +1,79 @@
+//! Test-only preparation: raw timing calls the same production target entry.
+use super::*;
+use crate::diagnostic::{Sample, enabled, sample, wrapper};
+use std::hint::black_box;
+struct TimingFactory;
+impl<T: FftNum> Factory<T> for TimingFactory {
+    type Output = Vec<Sample>;
+    fn make<
+        V: FixedVector,
+        const N: usize,
+        const L: usize,
+        const A: usize,
+        const B: usize,
+        const INV: bool,
+    >(
+        plan: Fixed<T, V, N, L, A, B, INV>,
+    ) -> Self::Output {
+        let mut result = wrapper(&plan, "concrete");
+        if !enabled("SURFACE", "kernel") {
+            return result;
+        }
+        let zero = Complex::new(T::zero(), T::zero());
+        let mut input = vec![zero; N];
+        let mut output = input.clone();
+        let mut scratch = vec![zero; plan.get_inplace_scratch_len()];
+        assert_eq!(input.len(), N);
+        assert_eq!(output.len(), N);
+        let ip = input.as_mut_ptr().cast::<V::S>();
+        let op = output.as_mut_ptr().cast::<V::S>();
+        let sp = scratch.as_mut_ptr();
+        let offset = sp.align_offset(64).min(align_slack::<T>());
+        assert!(scratch.len() - offset >= N);
+        // SAFETY: constructor checked T=V::S, alignment remains within slack.
+        let (tables, sp) = unsafe {
+            (
+                &*(&plan.plan as *const StockhamPlan<T>).cast::<StockhamPlan<V::S>>(),
+                sp.add(offset).cast::<V::S>(),
+            )
+        };
+        for (placement, mode) in [
+            ("ip", Mode::InPlace),
+            ("op", Mode::OutOfPlace),
+            ("immutable", Mode::Immutable),
+        ] {
+            let dst = if mode == Mode::InPlace { ip } else { op };
+            let ns = sample(|| {
+                // SAFETY: complete chunks, validated scratch/tables, available tier.
+                unsafe {
+                    V::run::<N, L, A, B, INV>(
+                        black_box(tables),
+                        black_box(ip),
+                        black_box(dst),
+                        black_box(sp),
+                        1,
+                        mode,
+                    );
+                }
+                black_box(dst);
+            });
+            black_box(&input);
+            black_box(&output);
+            black_box(&scratch);
+            result.push(Sample {
+                surface: "kernel",
+                placement,
+                ns,
+            });
+        }
+        result
+    }
+}
+pub(crate) fn timings<T: FftNum>(
+    n: usize,
+    dir: FftDirection,
+    shape: Shape,
+    radices: &[usize],
+) -> Option<Vec<Sample>> {
+    build_with::<T, TimingFactory>(n, dir, shape, radices)
+}
diff --git a/crates/fastfft/src/engine/small.rs b/crates/fastfft/src/engine/small.rs
new file mode 100644
index 0000000..5076e46
--- /dev/null
+++ b/crates/fastfft/src/engine/small.rs
@@ -0,0 +1,690 @@
+//! Scratch-free, length-specialized codelets and fused two-stage transforms.
+//!
+//! All inputs are loaded before any output is stored, including partial
+//! vectors. ISA, length, decomposition and direction are resolved at planning.
+
+use crate::api::{Direction, Fft, FftDirection, FftNum, Length};
+use crate::codelets::generated;
+use crate::engine::{Shape, stockham::transpose};
+use crate::fft::{fail_inplace, fail_outofplace};
+use crate::isa::{Isa, Precision, Vector, scalar};
+use num_complex::Complex;
+use std::marker::PhantomData;
+use std::sync::Arc;
+
+#[cfg(all(target_arch = "x86_64", feature = "avx2"))]
+mod interleaved;
+#[cfg(all(target_arch = "x86_64", feature = "avx2"))]
+mod specialized;
+
+#[cfg(test)]
+mod timing;
+#[cfg(test)]
+pub(crate) use timing::timings;
+
+/// Target-feature boundary enclosing the entire batch loop.
+trait SmallVector: Vector + Send + Sync + 'static {
+    /// One complete transform, with the same pointer/feature contract as run.
+    #[inline(always)]
+    unsafe fn one<const N: usize, const M: usize, const L: usize, const INV: bool>(
+        input: *const Self::S,
+        output: *mut Self::S,
+        tw: *const Self::S,
+    ) {
+        // SAFETY: complete buffers and matching features supplied by caller.
+        unsafe {
+            if L == 1 {
+                direct::<Self, N, INV>(input, output);
+            } else {
+                Self::kernel::<M, L, INV>(input, output, tw);
+            }
+        }
+    }
+    #[inline(always)]
+    unsafe fn kernel<const M: usize, const L: usize, const INV: bool>(
+        input: *const Self::S,
+        output: *mut Self::S,
+        tw: *const Self::S,
+    ) {
+        // SAFETY: matching features, M*L inputs/outputs and L-wide tables.
+        unsafe { fused::<Self, M, L, INV>(input, output, tw) }
+    }
+
+    /// Pointers hold `count * N` complex values; they are identical or
+    /// disjoint. Twiddles hold `2 * L * L` scalars for SIMD. Features match V.
+    #[inline(always)]
+    unsafe fn run<const N: usize, const M: usize, const L: usize, const INV: bool>(
+        input: *const Self::S,
+        output: *mut Self::S,
+        count: usize,
+        tw: *const Self::S,
+    ) {
+        // SAFETY: forwarded buffer and feature contract.
+        unsafe { run::<Self, N, M, L, INV>(input, output, count, tw) }
+    }
+}
+
+#[inline(always)]
+unsafe fn direct<V: Vector, const N: usize, const INV: bool>(
+    input: *const V::S,
+    output: *mut V::S,
+) {
+    // SAFETY: scalar V, pointers valid for 2N scalars. Every input is read
+    // before stores, so input and output may be the same buffer.
+    unsafe {
+        let zero = V::splat_f64(0.0);
+        let mut re = [zero; N];
+        let mut im = [zero; N];
+        for j in 0..N {
+            re[j] = V::load(input.add(2 * j + usize::from(INV)));
+            im[j] = V::load(input.add(2 * j + usize::from(!INV)));
+        }
+        generated::small_notw::<V, N>(&mut re, &mut im);
+        for j in 0..N {
+            V::store(output.add(2 * j + usize::from(INV)), re[j]);
+            V::store(output.add(2 * j + usize::from(!INV)), im[j]);
+        }
+    }
+}
+
+#[inline(always)]
+unsafe fn fused<V: Vector, const M: usize, const L: usize, const INV: bool>(
+    input: *const V::S,
+    output: *mut V::S,
+    tw: *const V::S,
+) {
+    // SAFETY: N=M*L, M<=L, L=V::LANES. Each load reads exactly L complex
+    // inputs, all before stores. The short stores copy only M complex outputs.
+    unsafe {
+        let zero = V::splat_f64(0.0);
+        let mut a = [zero; M];
+        let mut b = [zero; M];
+        for j in 0..M {
+            let p = input.add(2 * L * j);
+            let (r, i) = V::deinterleave(V::load(p), V::load(p.add(L)));
+            (a[j], b[j]) = if INV { (i, r) } else { (r, i) };
+        }
+        if M > 1 {
+            generated::small_notw::<V, M>(&mut a, &mut b);
+        }
+        let mut re = [zero; L];
+        let mut im = [zero; L];
+        re[..M].copy_from_slice(&a);
+        im[..M].copy_from_slice(&b);
+        transpose::<V, L>(&mut re);
+        transpose::<V, L>(&mut im);
+        if M == 1 {
+            generated::small_notw::<V, L>(&mut re, &mut im);
+        } else {
+            let mut wr = [zero; L];
+            let mut wi = [zero; L];
+            for j in 1..L {
+                wr[j] = V::load(tw.add(2 * L * j));
+                wi[j] = V::load(tw.add(2 * L * j + L));
+            }
+            generated::small_tw::<V, L>(&mut re, &mut im, &wr, &wi);
+        }
+        for j in 0..L {
+            let (lo, hi) = if INV {
+                V::interleave(im[j], re[j])
+            } else {
+                V::interleave(re[j], im[j])
+            };
+            let p = output.add(2 * M * j);
+            if M == L {
+                V::store(p, lo);
+                V::store(p.add(L), hi);
+            } else {
+                // Constant-sized copies lower to short unaligned stores; no
+                // masked full-width access can overread or overwrite a guard.
+                let mut tmp = [V::S::default(); 16];
+                V::store(tmp.as_mut_ptr(), lo);
+                V::store(tmp.as_mut_ptr().add(L), hi);
+                core::ptr::copy_nonoverlapping(tmp.as_ptr(), p, 2 * M);
+            }
+        }
+    }
+}
+
+/// Transpose four rows of eight lanes into eight rows of four. Arithmetic
+/// after the transpose uses the narrower registers, with no padded lanes.
+#[cfg(all(target_arch = "x86_64", any(feature = "avx2", feature = "avx512")))]
+#[inline(always)]
+unsafe fn fused_4x8<V: crate::isa::HalfVector, const INV: bool>(
+    input: *const V::S,
+    output: *mut V::S,
+    tw: *const V::S,
+) {
+    use crate::isa::SimdReal;
+    // SAFETY: source has 32 complex values, table has 128 scalars, and
+    // features cover V and V::Half. Stores begin after every input load.
+    unsafe {
+        let mut a = [V::splat_f64(0.0); 4];
+        let mut b = a;
+        for j in 0..4 {
+            let (r, i) =
+                V::deinterleave(V::load(input.add(j * 16)), V::load(input.add(j * 16 + 8)));
+            (a[j], b[j]) = if INV { (i, r) } else { (r, i) };
+        }
+        generated::small_notw::<V, 4>(&mut a, &mut b);
+        transpose::<V, 4>(&mut a);
+        transpose::<V, 4>(&mut b);
+        let mut re = [V::Half::splat_f64(0.0); 8];
+        let mut im = re;
+        for j in 0..4 {
+            (re[j], re[j + 4]) = V::halves(a[j]);
+            (im[j], im[j + 4]) = V::halves(b[j]);
+        }
+        let mut wr = re;
+        let mut wi = im;
+        for j in 1..8 {
+            wr[j] = V::Half::load(tw.add(j * 16));
+            wi[j] = V::Half::load(tw.add(j * 16 + 8));
+        }
+        generated::small_tw::<V::Half, 8>(&mut re, &mut im, &wr, &wi);
+        for j in 0..8 {
+            let (lo, hi) = if INV {
+                V::Half::interleave(im[j], re[j])
+            } else {
+                V::Half::interleave(re[j], im[j])
+            };
+            V::Half::store(output.add(j * 8), lo);
+            V::Half::store(output.add(j * 8 + 4), hi);
+        }
+    }
+}
+
+#[inline(always)]
+unsafe fn run<V: SmallVector, const N: usize, const M: usize, const L: usize, const INV: bool>(
+    mut input: *const V::S,
+    mut output: *mut V::S,
+    count: usize,
+    tw: *const V::S,
+) {
+    // SAFETY: each iteration consumes exactly N complex values, as validated
+    // by the public wrapper. Shape and features were validated when planning.
+    unsafe {
+        for _ in 0..count {
+            if L == 1 {
+                direct::<V, N, INV>(input, output);
+            } else {
+                V::kernel::<M, L, INV>(input, output, tw);
+            }
+            input = input.add(2 * N);
+            output = output.add(2 * N);
+        }
+    }
+}
+
+impl SmallVector for scalar::S32 {}
+impl SmallVector for scalar::S64 {}
+
+#[allow(unused_macros)]
+macro_rules! vector {
+    ($v:ty, $features:literal $(, $half:ident)?) => {
+        impl SmallVector for $v {
+            #[target_feature(enable = $features)]
+            unsafe fn one<const N: usize, const M: usize, const L: usize, const INV: bool>(
+                input: *const Self::S, output: *mut Self::S, tw: *const Self::S,
+            ) {
+                // SAFETY: matching features and complete buffers from caller.
+                unsafe {
+                    if L == 1 { direct::<Self,N,INV>(input,output); }
+                    else { Self::kernel::<M,L,INV>(input,output,tw); }
+                }
+            }
+            $(
+                #[inline(always)]
+                unsafe fn kernel<const M:usize,const L:usize,const INV:bool>(input:*const Self::S,output:*mut Self::S,tw:*const Self::S) {
+                    // SAFETY: matching features and validated buffers/tables.
+                    unsafe {
+                        if M==4 && L==8 { $half::<Self,INV>(input,output,tw); }
+                        else { fused::<Self,M,L,INV>(input,output,tw); }
+                    }
+                }
+            )?
+            #[target_feature(enable = $features)]
+            unsafe fn run<const N: usize, const M: usize, const L: usize, const INV: bool>(
+                input: *const Self::S,
+                output: *mut Self::S,
+                count: usize,
+                tw: *const Self::S,
+            ) {
+                // SAFETY: matching features and forwarded buffer contract.
+                unsafe { run::<Self, N, M, L, INV>(input, output, count, tw) }
+            }
+        }
+    };
+}
+#[cfg(all(target_arch = "x86_64", feature = "sse2"))]
+vector!(crate::isa::x86::F32x4, "sse2");
+#[cfg(all(target_arch = "x86_64", feature = "sse2"))]
+vector!(crate::isa::x86::F64x2, "sse2");
+#[cfg(all(target_arch = "x86_64", feature = "avx2"))]
+vector!(crate::isa::x86::F32x8, "avx2,fma", fused_4x8);
+#[cfg(all(target_arch = "x86_64", feature = "avx2"))]
+vector!(crate::isa::x86::F64x4, "avx2,fma");
+#[cfg(all(target_arch = "x86_64", feature = "avx512"))]
+vector!(
+    crate::isa::x86::F32x8v,
+    "avx512f,avx512vl,avx512dq,avx512bw,avx512cd,avx2,fma",
+    fused_4x8
+);
+#[cfg(all(target_arch = "x86_64", feature = "avx512"))]
+vector!(
+    crate::isa::x86::F64x4v,
+    "avx512f,avx512vl,avx512dq,avx512bw,avx512cd,avx2,fma"
+);
+#[cfg(all(target_arch = "x86_64", feature = "avx512"))]
+vector!(
+    crate::isa::x86::F64x8,
+    "avx512f,avx512vl,avx512dq,avx512bw,avx512cd,avx2,fma",
+    fused_4x8
+);
+
+#[cfg(all(target_arch = "x86_64", feature = "avx2"))]
+vector!(scalar::A32, "avx2,fma");
+#[cfg(all(target_arch = "x86_64", feature = "avx2"))]
+vector!(scalar::A64, "avx2,fma");
+#[cfg(all(target_arch = "x86_64", feature = "avx512"))]
+vector!(
+    scalar::Z32,
+    "avx512f,avx512vl,avx512dq,avx512bw,avx512cd,avx2,fma"
+);
+#[cfg(all(target_arch = "x86_64", feature = "avx512"))]
+vector!(
+    scalar::Z64,
+    "avx512f,avx512vl,avx512dq,avx512bw,avx512cd,avx2,fma"
+);
+
+trait Kernel<V: SmallVector>: Send + Sync + 'static {
+    const TABLES: bool;
+    unsafe fn one<const N: usize, const M: usize, const L: usize, const INV: bool>(
+        input: *const V::S,
+        output: *mut V::S,
+        tw: *const V::S,
+    );
+    unsafe fn run<const N: usize, const M: usize, const L: usize, const INV: bool>(
+        input: *const V::S,
+        output: *mut V::S,
+        count: usize,
+        tw: *const V::S,
+    );
+}
+struct Generic;
+impl<V: SmallVector> Kernel<V> for Generic {
+    const TABLES: bool = true;
+    #[inline(always)]
+    unsafe fn one<const N: usize, const M: usize, const L: usize, const INV: bool>(
+        input: *const V::S,
+        output: *mut V::S,
+        tw: *const V::S,
+    ) {
+        // SAFETY: forwarded validated buffers and matching features.
+        unsafe {
+            V::one::<N, M, L, INV>(input, output, tw);
+        }
+    }
+    #[inline(always)]
+    unsafe fn run<const N: usize, const M: usize, const L: usize, const INV: bool>(
+        input: *const V::S,
+        output: *mut V::S,
+        count: usize,
+        tw: *const V::S,
+    ) {
+        // SAFETY: forwarded validated buffers and matching features.
+        unsafe {
+            V::run::<N, M, L, INV>(input, output, count, tw);
+        }
+    }
+}
+
+struct Small<T, V, const N: usize, const M: usize, const L: usize, const INV: bool, K = Generic> {
+    tw: Vec<T>,
+    vector: PhantomData<(V, K)>,
+}
+
+impl<T, V, const N: usize, const M: usize, const L: usize, const INV: bool, K> Length
+    for Small<T, V, N, M, L, INV, K>
+{
+    fn len(&self) -> usize {
+        N
+    }
+}
+impl<T, V, const N: usize, const M: usize, const L: usize, const INV: bool, K> Direction
+    for Small<T, V, N, M, L, INV, K>
+{
+    fn fft_direction(&self) -> FftDirection {
+        if INV {
+            FftDirection::Inverse
+        } else {
+            FftDirection::Forward
+        }
+    }
+}
+impl<
+    T: FftNum,
+    V: SmallVector,
+    const N: usize,
+    const M: usize,
+    const L: usize,
+    const INV: bool,
+    K: Kernel<V>,
+> Fft<T> for Small<T, V, N, M, L, INV, K>
+{
+    fn process(&self, buffer: &mut [Complex<T>]) {
+        self.process_with_scratch(buffer, &mut []);
+    }
+    fn process_with_scratch(&self, buffer: &mut [Complex<T>], _: &mut [Complex<T>]) {
+        if buffer.len() == N {
+            // SAFETY: one complete aliased transform, matching type and ISA
+            // checked in the builder; all inputs are loaded before stores.
+            unsafe {
+                K::one::<N, M, L, INV>(
+                    buffer.as_ptr().cast(),
+                    buffer.as_mut_ptr().cast(),
+                    self.tw.as_ptr().cast(),
+                );
+            }
+            return;
+        }
+        if buffer.len() < N || !buffer.len().is_multiple_of(N) {
+            fail_inplace(N, buffer.len(), 0, 0);
+        }
+        // SAFETY: builder checks that T=V::S and the tier is available. Each
+        // chunk contains N elements; kernels load before overwriting inputs.
+        unsafe {
+            K::run::<N, M, L, INV>(
+                buffer.as_ptr().cast(),
+                buffer.as_mut_ptr().cast(),
+                buffer.len() / N,
+                self.tw.as_ptr().cast(),
+            );
+        }
+    }
+    fn process_outofplace_with_scratch(
+        &self,
+        input: &mut [Complex<T>],
+        output: &mut [Complex<T>],
+        scratch: &mut [Complex<T>],
+    ) {
+        self.process_immutable_with_scratch(input, output, scratch);
+    }
+    fn process_immutable_with_scratch(
+        &self,
+        input: &[Complex<T>],
+        output: &mut [Complex<T>],
+        _: &mut [Complex<T>],
+    ) {
+        if input.len() == N && output.len() == N {
+            // SAFETY: one complete disjoint transform, matching type and ISA
+            // checked in the builder. Kernels only read the input pointer.
+            unsafe {
+                K::one::<N, M, L, INV>(
+                    input.as_ptr().cast(),
+                    output.as_mut_ptr().cast(),
+                    self.tw.as_ptr().cast(),
+                );
+            }
+            return;
+        }
+        if input.len() != output.len() || input.len() < N || !input.len().is_multiple_of(N) {
+            fail_outofplace(N, input.len(), output.len(), 0, 0);
+        }
+        // SAFETY: validated equal lengths and complete chunks, disjoint
+        // buffers, matching scalar type and available features from builder.
+        unsafe {
+            K::run::<N, M, L, INV>(
+                input.as_ptr().cast(),
+                output.as_mut_ptr().cast(),
+                input.len() / N,
+                self.tw.as_ptr().cast(),
+            );
+        }
+    }
+    fn get_inplace_scratch_len(&self) -> usize {
+        0
+    }
+    fn get_outofplace_scratch_len(&self) -> usize {
+        0
+    }
+    fn get_immutable_scratch_len(&self) -> usize {
+        0
+    }
+}
+
+pub(crate) fn eligible(n: usize, shape: Shape) -> bool {
+    let l = shape.lanes;
+    if l == 1 {
+        return (2..=16).contains(&n);
+    }
+    l <= 8 && n >= l && n.is_multiple_of(l) && n / l <= l.min(8)
+}
+
+trait Factory<T: FftNum> {
+    type Output;
+    fn make<
+        V: SmallVector,
+        const N: usize,
+        const M: usize,
+        const L: usize,
+        const INV: bool,
+        K: Kernel<V>,
+    >(
+        plan: Small<T, V, N, M, L, INV, K>,
+    ) -> Self::Output;
+}
+struct PlanFactory;
+impl<T: FftNum> Factory<T> for PlanFactory {
+    type Output = Arc<dyn Fft<T>>;
+    fn make<
+        V: SmallVector,
+        const N: usize,
+        const M: usize,
+        const L: usize,
+        const INV: bool,
+        K: Kernel<V>,
+    >(
+        plan: Small<T, V, N, M, L, INV, K>,
+    ) -> Self::Output {
+        Arc::new(plan)
+    }
+}
+
+fn sized<
+    T: FftNum,
+    V: SmallVector,
+    F: Factory<T>,
+    const N: usize,
+    const M: usize,
+    const L: usize,
+    K: Kernel<V>,
+>(
+    dir: FftDirection,
+) -> F::Output {
+    // FftNum is sealed to f32/f64; Vector's scalar is likewise one of these.
+    assert_eq!(size_of::<T>(), size_of::<V::S>());
+    assert!(L == V::LANES || (!K::TABLES && N == 32 && L == 8 && V::LANES == 4));
+    assert_eq!(N, M * L);
+    assert!(L == 1 || (M <= L && M <= 8 && L <= 8));
+    let mut tw = if L == 1 || !K::TABLES {
+        Vec::new()
+    } else {
+        vec![T::zero(); 2 * L * L]
+    };
+    for j in 1..if K::TABLES { L } else { 1 } {
+        for k in 0..M {
+            let (r, i) = crate::twiddle::omega(j * k, N);
+            tw[2 * L * j + k] = T::from_f64(r).unwrap();
+            tw[2 * L * j + L + k] = T::from_f64(i).unwrap();
+        }
+    }
+    if dir == FftDirection::Inverse {
+        F::make(Small::<T, V, N, M, L, true, K> {
+            tw,
+            vector: PhantomData,
+        })
+    } else {
+        F::make(Small::<T, V, N, M, L, false, K> {
+            tw,
+            vector: PhantomData,
+        })
+    }
+}
+
+fn for_vector<T: FftNum, V: SmallVector, F: Factory<T>>(n: usize, dir: FftDirection) -> F::Output {
+    macro_rules! size {
+        ($n:literal, $m:literal, $l:literal) => {
+            sized::<T, V, F, $n, $m, $l, Generic>(dir)
+        };
+    }
+    match (n, V::LANES) {
+        (2, 1) => size!(2, 2, 1),
+        (3, 1) => size!(3, 3, 1),
+        (4, 1) => size!(4, 4, 1),
+        (5, 1) => size!(5, 5, 1),
+        (6, 1) => size!(6, 6, 1),
+        (7, 1) => size!(7, 7, 1),
+        (8, 1) => size!(8, 8, 1),
+        (9, 1) => size!(9, 9, 1),
+        (10, 1) => size!(10, 10, 1),
+        (11, 1) => size!(11, 11, 1),
+        (12, 1) => size!(12, 12, 1),
+        (13, 1) => size!(13, 13, 1),
+        (14, 1) => size!(14, 14, 1),
+        (15, 1) => size!(15, 15, 1),
+        (16, 1) => size!(16, 16, 1),
+        (2, 2) => size!(2, 1, 2),
+        (4, 2) => size!(4, 2, 2),
+        (4, 4) => size!(4, 1, 4),
+        (8, 4) => size!(8, 2, 4),
+        (12, 4) => size!(12, 3, 4),
+        (16, 4) => size!(16, 4, 4),
+        (8, 8) => size!(8, 1, 8),
+        (16, 8) => size!(16, 2, 8),
+        (24, 8) => size!(24, 3, 8),
+        (32, 8) => size!(32, 4, 8),
+        (40, 8) => size!(40, 5, 8),
+        (48, 8) => size!(48, 6, 8),
+        (56, 8) => size!(56, 7, 8),
+        (64, 8) => size!(64, 8, 8),
+        _ => unreachable!("ineligible Small shape"),
+    }
+}
+
+/// Small-only shapes: never add these narrow widths to general Stockham.
+pub(crate) fn specialized_shapes(n: usize, cap: Isa, f64_: bool) -> Vec<Shape> {
+    let (tiers, lanes): (&[Isa], usize) = match (n, f64_) {
+        (32, false) => (&[Isa::Avx2], 8),
+        (8, false) => (&[Isa::Avx2], 4),
+        _ => return Vec::new(),
+    };
+    tiers
+        .iter()
+        .copied()
+        .filter(|&isa| isa <= cap && crate::isa::available(isa))
+        .map(|isa| Shape { isa, lanes })
+        .collect()
+}
+
+pub(crate) fn build_specialized<T: FftNum>(
+    n: usize,
+    dir: FftDirection,
+    shape: Shape,
+) -> Arc<dyn Fft<T>> {
+    #[cfg(all(target_arch = "x86_64", feature = "avx2"))]
+    {
+        specialized::build_with::<T, PlanFactory>(n, dir, shape)
+    }
+    #[cfg(not(all(target_arch = "x86_64", feature = "avx2")))]
+    {
+        let _ = (n, dir, shape);
+        unreachable!("no specialized leaves compiled");
+    }
+}
+
+/// Complex values per register row of the interleaved leaves: rows of four
+/// from N=8, otherwise one xmm.
+pub(crate) fn interleaved_lanes(n: usize, f64_: bool) -> usize {
+    match (n, f64_) {
+        (4, false) => 2,
+        (2 | 4, _) => 1,
+        _ => 4,
+    }
+}
+
+/// Interleaved-complex leaves: N = 2..32 in either precision, 64 and 128 in
+/// f32, each under AVX2 and (for 32 registers) AVX-512VL entries.
+pub(crate) fn interleaved_shapes(n: usize, cap: Isa, f64_: bool) -> Vec<Shape> {
+    #[cfg(all(target_arch = "x86_64", feature = "avx2"))]
+    {
+        interleaved::shapes(n, cap, f64_)
+    }
+    #[cfg(not(all(target_arch = "x86_64", feature = "avx2")))]
+    {
+        let _ = (n, cap, f64_);
+        Vec::new()
+    }
+}
+
+pub(crate) fn build_interleaved<T: FftNum>(
+    n: usize,
+    dir: FftDirection,
+    shape: Shape,
+) -> Arc<dyn Fft<T>> {
+    #[cfg(all(target_arch = "x86_64", feature = "avx2"))]
+    {
+        interleaved::build::<T>(n, dir, shape)
+    }
+    #[cfg(not(all(target_arch = "x86_64", feature = "avx2")))]
+    {
+        let _ = (n, dir, shape);
+        unreachable!("no interleaved leaves compiled");
+    }
+}
+
+pub(crate) fn build<T: FftNum>(n: usize, dir: FftDirection, shape: Shape) -> Arc<dyn Fft<T>> {
+    build_with::<T, PlanFactory>(n, dir, shape)
+}
+
+fn build_with<T: FftNum, F: Factory<T>>(n: usize, dir: FftDirection, shape: Shape) -> F::Output {
+    assert!(eligible(n, shape) && crate::isa::available(shape.isa));
+    macro_rules! go {
+        ($v:ty) => {{
+            assert_eq!(shape.lanes, <$v as Vector>::LANES);
+            for_vector::<T, $v, F>(n, dir)
+        }};
+    }
+    if shape.lanes == 1 {
+        match (T::precision(), shape.isa) {
+            #[cfg(all(target_arch = "x86_64", feature = "avx2"))]
+            (Precision::F32, Isa::Avx2) => return go!(scalar::A32),
+            #[cfg(all(target_arch = "x86_64", feature = "avx2"))]
+            (Precision::F64, Isa::Avx2) => return go!(scalar::A64),
+            #[cfg(all(target_arch = "x86_64", feature = "avx512"))]
+            (Precision::F32, Isa::Avx512Ymm) => return go!(scalar::Z32),
+            #[cfg(all(target_arch = "x86_64", feature = "avx512"))]
+            (Precision::F64, Isa::Avx512Ymm) => return go!(scalar::Z64),
+            _ => {}
+        }
+    }
+    match (T::precision(), shape.isa) {
+        (Precision::F32, Isa::Scalar) => go!(scalar::S32),
+        (Precision::F64, Isa::Scalar) => go!(scalar::S64),
+        #[cfg(all(target_arch = "x86_64", feature = "sse2"))]
+        (Precision::F32, Isa::Sse2) => go!(crate::isa::x86::F32x4),
+        #[cfg(all(target_arch = "x86_64", feature = "sse2"))]
+        (Precision::F64, Isa::Sse2) => go!(crate::isa::x86::F64x2),
+        #[cfg(all(target_arch = "x86_64", feature = "avx2"))]
+        (Precision::F32, Isa::Avx2) => go!(crate::isa::x86::F32x8),
+        #[cfg(all(target_arch = "x86_64", feature = "avx2"))]
+        (Precision::F64, Isa::Avx2) => go!(crate::isa::x86::F64x4),
+        #[cfg(all(target_arch = "x86_64", feature = "avx512"))]
+        (Precision::F32, Isa::Avx512Ymm) => go!(crate::isa::x86::F32x8v),
+        #[cfg(all(target_arch = "x86_64", feature = "avx512"))]
+        (Precision::F64, Isa::Avx512Ymm) => go!(crate::isa::x86::F64x4v),
+        #[cfg(all(target_arch = "x86_64", feature = "avx512"))]
+        (Precision::F64, Isa::Avx512) => go!(crate::isa::x86::F64x8),
+        _ => unreachable!("unsupported Small tier"),
+    }
+}
