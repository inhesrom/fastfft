+        y: *const Self::S,
+        x: *mut Self::S,
+        m: usize,
+        vtw: *const Self::S,
+        one: Self,
+    ) {
+        // SAFETY: the caller supplies valid blocks and matching features.
+        unsafe { phase_b_blocks::<Self, L, USER, SWAP_LOAD, SWAP, PARTIAL>(y, x, m, vtw, one) }
+    }
+}
