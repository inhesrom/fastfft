+/// Execute a Stockham plan through the matching precision, direction and ISA.
+///
+/// # Safety
+/// The shape must be available and match the plan; all pointers satisfy
+/// `stockham::execute`'s buffer and scratch contracts.
+pub(crate) unsafe fn execute_stockham<T: FftNum>(
+    shape: Shape,
+    plan: &StockhamPlan<T>,
+    input: *mut T,
+    output: *mut T,
+    scratch: *mut T,
+    mode: Mode,
+    inverse: bool,
+) {
+    macro_rules! run {
+        ($scalar:ty, $entry:ident, $inverse:literal) => {
+            $entry::<$inverse>(
+                shape,
+                &*(plan as *const StockhamPlan<T>).cast::<StockhamPlan<$scalar>>(),
+                input.cast(),
+                output.cast(),
+                scratch.cast(),
+                mode,
+            )
+        };
+    }
+    // SAFETY: FftNum is sealed to the matched precision. The caller supplies
+    // the validated shape and complete buffers; direction changes no bounds.
+    unsafe {
+        match (T::precision(), inverse) {
+            (Precision::F32, false) => run!(f32, stockham_f32, false),
+            (Precision::F32, true) => run!(f32, stockham_f32, true),
+            (Precision::F64, false) => run!(f64, stockham_f64, false),
+            (Precision::F64, true) => run!(f64, stockham_f64, true),
+        }
+    }
+}
